# Backups and disk images: NEVER in git (too large / personal data)
backups/
*.img
*.img.gz
*.tar.gz
*.zip
!docs/Jooki-SD-Card-mac.zip
# Secrets / keys
*.pem
id_*
*.key
secrets/
.env
# System
.DS_Store

# Transient run artifacts (logs, device pulls)
run/_out_*.log
run/_device_pull/
run/_to_delete/

# Session driver scripts (local machine) — not for the public repo
run/
__pycache__/
*.pyc
# downloads of tools/openjooki/webui/make_tokimg.py
.tokimg-cache/

# Release build artifacts (assets uploaded to GitHub Releases, not committed)
release-*/

# Test bench: decoded Jooki program (Muuselabs code, never published) and generated media
tools/openjooki/tests/player*.lua
tools/openjooki/tests/player.lib
tools/openjooki/tests/media/
tools/openjooki/tests/shots/

# 2.0 core build output (tools/build/bundle.py)
/build/

# Shared tool settings are versioned; per-machine ones (settings.local.json) are not
!.claude/
.claude/*
!.claude/settings.json
!.claude/CLAUDE.md
