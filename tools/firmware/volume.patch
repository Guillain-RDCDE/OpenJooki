diff --git a/ml-yocto-jooki/sw/controllers/esp32_ctrl/volume_request.h b/ml-yocto-jooki/sw/controllers/esp32_ctrl/volume_request.h
new file mode 100644
index 0000000..258b97b
--- /dev/null
+++ b/ml-yocto-jooki/sw/controllers/esp32_ctrl/volume_request.h
@@ -0,0 +1,41 @@
+// Strict bounded parser for {"percent":0..100,"maximum":0..100?}.
+#ifndef OJ_VOLUME_REQUEST_H
+#define OJ_VOLUME_REQUEST_H
+#include <stdbool.h>
+#include <stddef.h>
+#include <string.h>
+static bool oj_volume_request(const char *s, size_t n, int *percent, int *maximum) {
+    if (!s || n > 96) return false;
+    size_t i = 0; bool have_percent = false, have_max = false;
+    *maximum = -1;
+#define OJ_SPACE() while (i < n && (s[i] == ' ' || s[i] == '\t' || s[i] == '\n' || s[i] == '\r')) ++i
+    OJ_SPACE(); if (i == n || s[i++] != '{') return false;
+    for (;;) {
+        OJ_SPACE(); if (i == n || s[i++] != '"') return false;
+        size_t key = i;
+        while (i < n && s[i] != '"') ++i;
+        if (i == n) return false;
+        size_t len = i++ - key;
+        bool is_percent = len == 7 && !memcmp(s + key, "percent", 7);
+        bool is_max = len == 7 && !memcmp(s + key, "maximum", 7);
+        if ((!is_percent && !is_max) || (is_percent && have_percent) || (is_max && have_max)) return false;
+        OJ_SPACE(); if (i == n || s[i++] != ':') return false;
+        OJ_SPACE(); if (i == n || s[i] < '0' || s[i] > '9') return false;
+        int value = s[i++] - '0';
+        if (value == 0 && i < n && s[i] >= '0' && s[i] <= '9') return false;
+        while (i < n && s[i] >= '0' && s[i] <= '9') {
+            value = value * 10 + s[i++] - '0';
+            if (value > 100) return false;
+        }
+        if (is_percent) { *percent = value; have_percent = true; }
+        else { *maximum = value; have_max = true; }
+        OJ_SPACE(); if (i == n) return false;
+        char delimiter = s[i++];
+        if (delimiter == '}') break;
+        if (delimiter != ',') return false;
+    }
+    OJ_SPACE();
+#undef OJ_SPACE
+    return i == n && have_percent;
+}
