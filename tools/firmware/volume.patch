diff --git a/esp32-code/jooki_v2/main/volume_control.h b/esp32-code/jooki_v2/main/volume_control.h
new file mode 100644
index 0000000..d85ae98
--- /dev/null
+++ b/esp32-code/jooki_v2/main/volume_control.h
@@ -0,0 +1,29 @@
+// OpenJooki volume arbitration. Caller serializes access with atomic_volume.
+#ifndef OJ_VOLUME_CONTROL_H
+#define OJ_VOLUME_CONTROL_H
+#include <stdbool.h>
+typedef struct { int requested, maximum, knob; bool host_set, global_scale; } oj_volume_t;
+#define OJ_VOLUME_INITIAL { 0, 100, -1, false, false }
+static inline int oj_volume_clamp(int v) { return v < 0 ? 0 : v > 100 ? 100 : v; }
+static inline bool oj_volume_host(oj_volume_t *s, int percent, unsigned maximum_plus_one) {
+    if (percent < 0 || percent > 100 || maximum_plus_one > 101) return false;
+    s->requested = percent;
+    if (maximum_plus_one) s->maximum = maximum_plus_one - 1;
+    s->host_set = true;
+    s->global_scale = true;
+    return true;
+}
+static inline void oj_volume_knob(oj_volume_t *s, int percent) {
+    percent = oj_volume_clamp(percent);
+    if (s->knob == percent) return;
+    if (s->knob >= 0 || !s->host_set) s->requested = percent;
+    s->knob = percent;
+}
+static inline int oj_volume_output(const oj_volume_t *s, bool muted) {
+    return muted ? 0 : (s->requested < s->maximum ? s->requested : s->maximum);
+}
+static inline void oj_volume_legacy(oj_volume_t *s) { s->global_scale = false; }
+static inline float oj_volume_gain(const oj_volume_t *s, float curve, bool toysafe, float normal, float kids) {
+    return curve * ((s->global_scale || !toysafe) ? normal : kids);
+}
+#endif
