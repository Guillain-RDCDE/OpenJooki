+// Additive command. Only call after volume_api=2 was returned by GetKnobsState.
+int set_volume(int percent, unsigned maximum_plus_one) {
+  if (percent < 0 || percent > 100 || maximum_plus_one > 101) return FAILURE;
+  EspHostedConfigPayload req = ESP_HOSTED_CONFIG_PAYLOAD__INIT;
+  EspHostedCmdSetVolume payload = ESP_HOSTED_CMD_SET_VOLUME__INIT;
+  payload.percent = percent;
+  payload.maximum_plus_one = maximum_plus_one;
+  req.msg = ESP_HOSTED_CONFIG_MSG_TYPE__TypeCmdSetVolume;
+  req.payload_case = ESP_HOSTED_CONFIG_PAYLOAD__PAYLOAD_CMD_SET_VOLUME;
+  req.cmd_set_volume = &payload;
+  size_t len = esp_hosted_config_payload__get_packed_size(&req);
+  uint8_t *tx = esp_hosted_calloc(1, len);
+  if (!tx) return FAILURE;
+  esp_hosted_config_payload__pack(&req, tx);
+  uint32_t rx_len = 0;
+  uint8_t *rx = transport_pserial_data_handler(tx, len, TIMEOUT_PSERIAL_RESP, &rx_len);
+  esp_hosted_free(tx);
+  if (!rx) return FAILURE;
+  EspHostedConfigPayload *resp = esp_hosted_config_payload__unpack(NULL, rx_len, rx);
+  int result = resp && resp->msg == ESP_HOSTED_CONFIG_MSG_TYPE__TypeRespSetVolume &&
+      resp->payload_case == ESP_HOSTED_CONFIG_PAYLOAD__PAYLOAD_RESP_SET_VOLUME &&
+      resp->resp_set_volume && resp->resp_set_volume->result == 0 ? SUCCESS : FAILURE;
+  if (resp) esp_hosted_config_payload__free_unpacked(resp, NULL);
+  esp_hosted_free(rx);
+  return result;
+}
