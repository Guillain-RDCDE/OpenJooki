+/** OpenJooki roaming: among scanned access points, the one to move to.
+ * @return its index in records, or -1 to stay on the current access point
+ * (link good enough, or nothing of the same network clearly stronger). */
+static int wcm_sta_roam_pick(int8_t currentRssi, const uint8_t *currentBssid,
+                             const uint8_t *ssid, const wifi_ap_record_t *records,
+                             int count) {
+    int i, best = -1;
+    int bestRssi = currentRssi + WCM_STA_ROAM_MARGIN - 1;
+
+    if (currentRssi >= WCM_STA_ROAM_RSSI) {
+        return -1;
+    }
+    for (i = 0; i < count; i++) {
+        if (memcmp(records[i].bssid, currentBssid, sizeof(records[i].bssid)) == 0 ||
+            strncmp((const char *)records[i].ssid, (const char *)ssid,
+                    sizeof(records[i].ssid)) != 0 ||
+            records[i].rssi < WCM_CONNECT_MINIMUM_RSSI) {
+            continue;
+        }
+        if (records[i].rssi > bestRssi) {
+            bestRssi = records[i].rssi;
+            best = i;
+        }
+    }
+    return best;
+}
+
+/** OpenJooki roaming: join the access point chosen by wcm_sta_roam_check(),
+ * once the station has left the previous one. */
+static bool wcm_sta_roam_connect(void) {
+    wifi_config_t cfg;
+
+    if (esp_wifi_get_config(WIFI_IF_STA, &cfg) != ESP_OK) {
+        return false;
+    }
+    memcpy(cfg.sta.bssid, _roamBssid, sizeof(cfg.sta.bssid));
+    cfg.sta.bssid_set = true;
+    cfg.sta.channel = _roamChannel;
+    if (esp_wifi_set_config(WIFI_IF_STA, &cfg) != ESP_OK) {
+        return false;
+    }
+    return esp_wifi_connect() == ESP_OK;
+}
+
+/** OpenJooki roaming: on a weak link, look for a stronger access point of the
+ * same network and leave the current one for it.
+ * @return how long to wait before the next check, in milliseconds. */
+static uint32_t wcm_sta_roam_check(void) {
+    static wifi_ap_record_t
+        accessPointRecords[WCM_STA_MAXIMUM_SCAN_RESULTS_COUNT];
+    wifi_ap_record_t current;
+    wifi_scan_config_t scanConf = {0};
+    uint16_t count = WCM_STA_MAXIMUM_SCAN_RESULTS_COUNT;
+    int best;
+
+    if (_state != sConnected || !_isCurrentlyConnected || _roaming ||
+        esp_wifi_sta_get_ap_info(&current) != ESP_OK ||
+        current.rssi >= WCM_STA_ROAM_RSSI) {
+        return WCM_STA_ROAM_CHECK_MS;
+    }
+
+    scanConf.ssid = current.ssid;
+    scanConf.scan_type = WIFI_SCAN_TYPE_ACTIVE;
+    if (esp_wifi_scan_start(&scanConf, true) != ESP_OK ||
+        esp_wifi_scan_get_ap_records(&count, accessPointRecords) != ESP_OK) {
+        return WCM_STA_ROAM_SCAN_MS;
+    }
+    best = wcm_sta_roam_pick(current.rssi, current.bssid, current.ssid,
+                             accessPointRecords, count);
+    if (best < 0 || _state != sConnected || !_isCurrentlyConnected) {
+        return WCM_STA_ROAM_SCAN_MS;
+    }
+
+    LOG_INFO(LOG_TAG_WCM_STA,
+             "Roaming from ..:%02x:%02x (RSSI = %d) to ..:%02x:%02x (RSSI = "
+             "%d, channel = %d).",
+             current.bssid[4], current.bssid[5], current.rssi,
+             accessPointRecords[best].bssid[4],
+             accessPointRecords[best].bssid[5],
+             accessPointRecords[best].rssi, accessPointRecords[best].primary);
+    memcpy(_roamBssid, accessPointRecords[best].bssid, sizeof(_roamBssid));
+    _roamChannel = accessPointRecords[best].primary;
+    _roaming = true;
+    if (esp_wifi_disconnect() != ESP_OK) {
+        _roaming = false;
+    }
+    return WCM_STA_ROAM_SCAN_MS;
+}
+
+static void task_wcm_roam_func(__unused void *param_) {
+    uint32_t waitMs = WCM_STA_ROAM_CHECK_MS;
+    while (1) {
+        vTaskDelay(pdMS_TO_TICKS(waitMs));
+        waitMs = wcm_sta_roam_check();
+    }
+}
