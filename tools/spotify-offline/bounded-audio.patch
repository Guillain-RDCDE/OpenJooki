index f277f8b..7b1687b 100644
--- a/spotify_player/src/downloads/player.rs
+++ b/spotify_player/src/downloads/player.rs
@@ -1 +1,4 @@
-use std::{sync::Arc, time::Duration};
+use std::{
+    sync::Arc,
+    time::{Duration, Instant},
+};
@@ -30 +33 @@ enum Control {
-#[derive(Clone)]
+#[derive(Clone, serde::Serialize)]
@@ -38,0 +42,57 @@ struct Status {
+pub fn run_headless(
+    library: &Library,
+    tracks: &[Download],
+    duration: Duration,
+) -> Result<serde_json::Value> {
+    anyhow::ensure!(
+        !tracks.is_empty(),
+        "no downloaded tracks for headless playback"
+    );
+    let status = Arc::new(Mutex::new(Status {
+        current: None,
+        position_ms: 0,
+        playing: false,
+        volume: crate::config::get_config()
+            .app_config
+            .device
+            .volume
+            .min(100),
+        error: None,
+    }));
+    let (sender, receiver) = flume::unbounded();
+    let worker_status = status.clone();
+    let worker_library = library.clone();
+    let worker_tracks = tracks.to_owned();
+    let worker = std::thread::Builder::new()
+        .name("offline-audio".into())
+        .spawn(move || {
+            if let Err(err) = audio_loop(&worker_library, &worker_tracks, &receiver, &worker_status)
+            {
+                let mut state = worker_status.lock();
+                state.error = Some(format!("Audio output failed: {err:#}"));
+                state.playing = false;
+            }
+        })?;
+    let _ = sender.send(Control::Play(0));
+    let started = Instant::now();
+    loop {
+        let state = status.lock().clone();
+        if state.error.is_some()
+            || (state.current.is_some() && !state.playing)
+            || started.elapsed() >= duration
+        {
+            break;
+        }
+        std::thread::sleep(Duration::from_millis(50));
+    }
+    let _ = sender.send(Control::Stop);
+    anyhow::ensure!(worker.join().is_ok(), "offline audio worker failed");
+    status.lock().playing = false;
+    let state = status.lock().clone();
+    if let Some(error) = &state.error {
+        anyhow::bail!("{error}");
+    }
+    anyhow::ensure!(state.current.is_some(), "audio output did not start");
+    Ok(serde_json::to_value(state)?)
+}
+
