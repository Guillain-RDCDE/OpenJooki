+        assert!(fs::metadata(output).unwrap().len() <= PUBLIC_JSON);
+    }
+    #[test]
+    fn automatic_quota_uses_available_disk_space_and_keeps_the_reserve() {
+        let root = tempfile::tempdir().unwrap();
+        let mut p = paths(root.path());
+        fs::create_dir_all(&p.root).unwrap();
+        p.quota = 0;
+        let before = used_bytes(&p.root).unwrap();
+        let free = free_bytes(&p.root).unwrap();
+        let budget = effective_quota(&p).unwrap();
+        assert!(budget.abs_diff(before + free.saturating_sub(AUTO_RESERVE)) < 1024 * 1024);
+        assert!(check_capacity(&p, free).is_err());
+        assert!(check_capacity(&p, 1).is_ok());
+    }
+    #[test]
+    fn the_public_song_schema_contains_neither_keys_nor_storage_paths() {
+        let root = tempfile::tempdir().unwrap();
+        let p = paths(root.path());
+        let lib = stage(&p);
+        let track = fixture(&lib, "1111111111111111111111", "First");
+        let public = serde_json::to_value(track).unwrap();
+        assert!(public.get("key").is_none());
+        assert!(public.get("directory").is_none());
+        assert!(public.get("uri").is_some());
+    }
+}
