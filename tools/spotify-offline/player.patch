+
+struct Region<R> {
+    reader: R,
+    offset: u64,
+    length: u64,
+    position: u64,
+}
+
+impl<R: Read + Seek> Region<R> {
+    fn new(mut reader: R, offset: u64, length: u64) -> io::Result<Self> {
+        reader.seek(SeekFrom::Start(offset))?;
+        Ok(Self {
+            reader,
+            offset,
+            length,
+            position: 0,
+        })
+    }
+}
+
+impl<R: Read> Read for Region<R> {
+    fn read(&mut self, buffer: &mut [u8]) -> io::Result<usize> {
+        let limit = (self.length - self.position).min(buffer.len() as u64) as usize;
+        let count = self.reader.read(&mut buffer[..limit])?;
+        self.position += count as u64;
+        Ok(count)
+    }
+}
+
+impl<R: Seek> Seek for Region<R> {
+    fn seek(&mut self, from: SeekFrom) -> io::Result<u64> {
+        let position = match from {
+            SeekFrom::Start(position) => i128::from(position),
+            SeekFrom::Current(delta) => i128::from(self.position) + i128::from(delta),
+            SeekFrom::End(delta) => i128::from(self.length) + i128::from(delta),
+        };
+        if position < 0 || position > i128::from(self.length) {
+            return Err(io::Error::new(
+                io::ErrorKind::InvalidInput,
+                "seek outside audio region",
+            ));
+        }
+        let position = position as u64;
+        self.reader.seek(SeekFrom::Start(self.offset + position))?;
+        self.position = position;
+        Ok(position)
+    }
+}
+
+impl<R: Read + Seek + Send + Sync> MediaSource for Region<R> {
+    fn is_seekable(&self) -> bool {
+        true
+    }
+    fn byte_len(&self) -> Option<u64> {
+        Some(self.length)
+    }
+}
