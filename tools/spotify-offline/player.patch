+struct Lock {
+    _file: File,
+}
+impl Lock {
+    fn take(path: &Path) -> Result<Self> {
+        let mut file = OpenOptions::new()
+            .read(true)
+            .write(true)
+            .create(true)
+            .truncate(false)
+            .open(path)?;
+        // Keep the same inode: replacing a live flock file would permit a second owner.
+        rustix::fs::flock(&file, rustix::fs::FlockOperation::NonBlockingLockExclusive)
+            .context("busy: another managed operation owns the lock")?;
+        file.set_len(0)?;
+        serde_json::to_writer(&mut file, &Process::current()?)?;
+        file.flush()?;
+        Ok(Self { _file: file })
+    }
+}
+impl Process {
+    fn current() -> Result<Self> {
+        let pid = std::process::id();
+        Ok(Self {
+            pid,
+            executable: std::env::current_exe()?,
+            start: process_start(pid),
+        })
+    }
+    fn alive(&self) -> bool {
+        if self.pid <= 1 || self.pid > i32::MAX as u32 {
+            return false;
+        }
+        let Some(pid) = rustix::process::Pid::from_raw(self.pid as i32) else {
+            return false;
+        };
+        if rustix::process::test_kill_process(pid).is_err() {
+            return false;
+        }
+        if cfg!(target_os = "linux") {
+            return self.start.is_some()
+                && process_start(self.pid) == self.start
+                && fs::read_link(format!("/proc/{}/exe", self.pid))
+                    .is_ok_and(|p| p == self.executable);
+        }
+        true
+    }
+}
+fn process_start(pid: u32) -> Option<String> {
+    let text = fs::read_to_string(format!("/proc/{pid}/stat")).ok()?;
+    text.rsplit_once(')')?
+        .1
+        .split_whitespace()
+        .nth(19)
+        .map(str::to_owned)
+}
+fn now() -> u64 {
+    SystemTime::now()
+        .duration_since(UNIX_EPOCH)
+        .unwrap_or_default()
+        .as_secs()
+}
+fn hash(bytes: &[u8]) -> String {
+    use std::fmt::Write as _;
+    Sha256::digest(bytes)
+        .iter()
+        .fold(String::with_capacity(64), |mut out, byte| {
+            let _ = write!(out, "{byte:02x}");
+            out
+        })
+}
+
+fn read_json<T: DeserializeOwned>(path: &Path) -> Result<T> {
+    let file = File::open(path)?;
+    ensure!(
+        file.metadata()?.len() <= MAX_JSON,
+        "managed JSON is too large"
+    );
+    Ok(serde_json::from_reader(file)?)
+}
+fn sync_dir(path: &Path) -> Result<()> {
+    File::open(path)?.sync_all()?;
+    Ok(())
+}
+
+fn write_public(path: &Path, value: &impl Serialize) -> Result<()> {
+    ensure!(
+        serde_json::to_vec(value)?.len() as u64 <= PUBLIC_JSON,
+        "metadata_limit"
+    );
+    write_json(path, value)
+}
+fn write_json(path: &Path, value: &impl Serialize) -> Result<()> {
+    let dir = path.parent().context("missing status directory")?;
+    fs::create_dir_all(dir)?;
+    let mut file = tempfile::NamedTempFile::new_in(dir)?;
+    let bytes = serde_json::to_vec(value)?;
+    ensure!(bytes.len() as u64 <= MAX_JSON, "metadata_limit");
+    file.write_all(&bytes)?;
+    file.write_all(b"\n")?;
+    file.as_file().sync_all()?;
+    file.persist(path)?;
+    sync_dir(dir)
+}
+fn free_bytes(root: &Path) -> Result<u64> {
+    let stat = rustix::fs::statvfs(root)?;
+    Ok(stat.f_bavail.saturating_mul(stat.f_frsize))
+}
+
+fn used_bytes(root: &Path) -> Result<u64> {
+    fn visit(root: &Path, seen: &mut HashSet<(u64, u64)>) -> Result<u64> {
+        let mut total = 0;
+        for item in fs::read_dir(root)? {
+            let item = item?;
+            let meta = fs::symlink_metadata(item.path())?;
+            if meta.is_dir() {
+                total += visit(&item.path(), seen)?;
+            } else if meta.is_file() && seen.insert((meta.dev(), meta.ino())) {
+                total += meta.len();
+            }
+        }
+        Ok(total)
+    }
+    visit(root, &mut HashSet::new())
+}
+fn account_id() -> Result<Option<String>> {
+    let username = auth::AuthConfig::new(config::get_config())?
+        .cache
+        .credentials()
+        .and_then(|c| c.username)
+        .filter(|s| !s.is_empty());
+    if let Some(username) = username {
+        return Ok(Some(hash(username.as_bytes())));
+    }
+    let info = config::get_config()
+        .cache_folder
+        .join("offline-account.json");
+    Ok(read_json::<serde_json::Value>(&info)
+        .ok()
+        .filter(|v| v["metadata_ready"] == true)
+        .and_then(|v| v["username"].as_str().map(|u| hash(u.as_bytes()))))
+}
+
+fn index_path(paths: &Paths, id: &str) -> PathBuf {
+    paths.account(id).join("index.json")
+}
+fn load_index(paths: &Paths, id: &str) -> Result<Index> {
+    let path = index_path(paths, id);
+    for candidate in [&path, &path.with_extension("json.bak")] {
+        if let Ok(index) = read_json::<Index>(candidate) {
+            ensure!(
+                index.version == VERSION && index.account_id == id,
+                "account_changed"
+            );
+            return Ok(index);
+        }
+    }
+    ensure!(!path.exists(), "snapshot_index_corrupt");
+    Ok(Index::empty(id))
+}
+fn save_index(paths: &Paths, index: &Index) -> Result<()> {
+    let path = index_path(paths, &index.account_id);
+    if path.exists() {
+        write_json(
+            &path.with_extension("json.bak"),
+            &load_index(paths, &index.account_id)?,
+        )?;
+    }
+    write_json(&path, index)
+}
+fn entry_library(paths: &Paths, id: &str, entry: &Entry) -> Result<Library> {
+    ensure!(
+        !entry.directory.is_empty()
+            && entry
+                .directory
+                .bytes()
+                .all(|c| c.is_ascii_hexdigit() || c == b'-'),
+        "invalid generation directory"
+    );
+    Ok(Library::new(
+        paths.account(id).join("generations").join(&entry.directory),
+    ))
+}
+fn select_complete(library: &Library, uri: &str, entry: &Entry) -> Result<Vec<Download>> {
+    ensure!(!entry.tracks.is_empty(), "empty_playlist");
+    let tracks = library.select(Some(uri))?;
+    ensure!(
+        tracks.len() == entry.tracks.len()
+            && tracks
+                .iter()
+                .zip(&entry.tracks)
+                .all(|(a, b)| a.uri == b.uri),
+        "incomplete_snapshot"
+    );
+    for track in &tracks {
+        library.verify_cover(track)?;
+    }
+    Ok(tracks)
+}
+fn publish_catalog(paths: &Paths, error: Option<&str>) -> Result<()> {
+    let id_result = account_id();
+    let mut catalog_error = error.map(str::to_owned);
+    let id = if let Ok(id) = id_result {
+        id
+    } else {
+        catalog_error = Some("authentication_required".into());
+        None
+    };
+    let mut playlists = BTreeMap::new();
+    if let Some(id) = &id {
+        let index = load_index(paths, id).unwrap_or_else(|_| {
+            catalog_error = Some("snapshot_index_corrupt".into());
+            Index::empty(id)
+        });
+        let page_limit = (200 / index.playlists.len().max(1)).min(super::native::PAGE_SIZE);
+        for (uri, entry) in index.playlists {
+            let ready = entry_library(paths, id, &entry)
+                .and_then(|l| select_complete(&l, &uri, &entry))
+                .is_ok();
+            playlists.insert(
+                uri,
+                PublicEntry {
+                    ready,
+                    total_tracks: entry.tracks.len(),
+                    name: entry.name,
+                    snapshot_id: entry.snapshot_id,
+                    synced_at: entry.synced_at,
+                    bytes: entry.bytes,
+                    tracks: entry.tracks.into_iter().take(page_limit).collect(),
+                },
+            );
+        }
+    }
+    write_public(
+        &paths.catalog,
+        &Catalog {
+            version: VERSION,
+            account_name: auth::AuthConfig::new(config::get_config())
+                .ok()
+                .and_then(|a| a.cache.credentials())
+                .and_then(|c| c.username)
+                .or_else(|| account_info()["username"].as_str().map(str::to_owned)),
+            premium_verified: verified_account(paths, id.as_deref()),
+            metadata_ready: metadata_ready(paths, id.as_deref()),
+            auth_request: account_info()["request"].as_str().map(str::to_owned),
+            reserve_bytes: if paths.quota == 0 {
+                AUTO_RESERVE
+            } else {
+                RESERVE
+            },
+            account_ready: verified_account(paths, id.as_deref()),
+            account_id: id,
+            used_bytes: used_bytes(&paths.root).unwrap_or(0),
+            free_bytes: free_bytes(&paths.root).unwrap_or(0),
+            quota_bytes: effective_quota(paths).unwrap_or(0),
+            playlists,
+            error: catalog_error,
+        },
+    )
+}
+fn publish_job(paths: &Paths, job: &Job) -> Result<()> {
+    write_public(&paths.job, job)?;
+    // On a full card the RAM status still reports the error and the old index survives.
+    let _ = write_json(
+        &paths.root.join("last-job.json"),
+        &SavedJob {
+            process: Process::current()?,
+            status: job.clone(),
+        },
+    );
+    Ok(())
+}
+fn recover_job(paths: &Paths) -> Result<()> {
+    if let Ok(mut saved) = read_json::<SavedJob>(&paths.root.join("last-job.json")) {
+        if saved.status.account_id != account_id()? {
+            saved.status.uri.clear();
+            saved.status.tracks.clear();
+            saved.status.phase = "idle".into();
+            saved.status.completed = 0;
+            saved.status.total = 0;
+            saved.status.error = None;
+        }
+        if ["resolving", "downloading", "verifying"].contains(&saved.status.phase.as_str())
+            && !saved.process.alive()
+        {
+            saved.status.phase = "interrupted".into();
+            saved.status.error = Some("interrupted".into());
+        }
+        write_json(&paths.job, &saved.status)?;
+    }
+    Ok(())
+}
+fn reuse(old: &Library, target: &Path) -> Result<()> {
+    for file in fs::read_dir(old.root())? {
+        let file = file?;
+        let path = file.path();
+        if path.is_file()
+            && path
+                .extension()
+                .is_some_and(|ext| ext == "spdl" || ext == "img")
+        {
+            let destination = target.join(file.file_name());
+            if !destination.exists() {
+                fs::hard_link(path, destination)?;
+            }
+        }
+    }
+    Ok(())
+}
+fn effective_quota(paths: &Paths) -> Result<u64> {
+    if paths.quota > 0 {
+        return Ok(paths.quota);
+    }
+    Ok(used_bytes(&paths.root)?
+        .saturating_add(free_bytes(&paths.root)?.saturating_sub(AUTO_RESERVE)))
+}
+fn account_info() -> serde_json::Value {
+    read_json(
+        &config::get_config()
+            .cache_folder
+            .join("offline-account.json"),
+    )
+    .unwrap_or_default()
+}
+fn metadata_ready(paths: &Paths, id: Option<&str>) -> bool {
+    let Some(id) = id else {
+        return false;
+    };
+    let info = account_info();
+    (info["account_id"] == id && info["metadata_ready"] == true)
+        || verified_account(paths, Some(id))
+}
+fn verified_account(paths: &Paths, id: Option<&str>) -> bool {
+    let Some(id) = id else {
+        return false;
+    };
+    let creds = auth::AuthConfig::new(config::get_config())
+        .ok()
+        .and_then(|a| a.cache.credentials())
+        .and_then(|c| c.username);
+    if creds.is_none_or(|u| hash(u.as_bytes()) != id) {
+        return false;
+    }
+    let info = account_info();
+    if info["metadata_ready"] == true && info["premium"] == false {
+        return false;
+    }
+    (info["account_id"] == id && info["premium"] == true)
+        || load_index(paths, id).is_ok_and(|i| !i.playlists.is_empty())
+}
+
+fn check_capacity(paths: &Paths, bytes: u64) -> Result<()> {
+    ensure!(
+        used_bytes(&paths.root)?.saturating_add(bytes.saturating_mul(3)) <= effective_quota(paths)?,
+        "storage_full: offline quota reached"
+    );
+    ensure!(
+        free_bytes(&paths.root)?
+            >= bytes.saturating_mul(3).saturating_add(if paths.quota == 0 {
+                AUTO_RESERVE
+            } else {
+                RESERVE
+            }),
+        "storage_full: insufficient free space"
+    );
+    Ok(())
+}
+fn prune_stage(library: &Library, uris: &[String]) -> Result<()> {
+    let mut keep = HashSet::new();
+    for uri in uris {
+        let track = library.track(uri)?;
+        keep.insert(uri.rsplit(':').next().context("track ID")?.to_owned() + ".spdl");
+        if let Some(url) = &track.cover_url {
+            keep.insert(
+                library
+                    .cover_path(url)
+                    .file_name()
+                    .context("cover name")?
+                    .to_string_lossy()
+                    .into_owned(),
+            );
+        }
+    }
+    for item in fs::read_dir(library.root())? {
+        let item = item?;
+        if item.file_type()?.is_file()
+            && !keep.contains(&item.file_name().to_string_lossy().into_owned())
+        {
+            fs::remove_file(item.path())?;
+        }
+    }
+    Ok(())
+}
+fn cleanup_generations(paths: &Paths, id: &str) -> Result<()> {
+    let mut keep = HashSet::new();
+    for path in [
+        index_path(paths, id),
+        index_path(paths, id).with_extension("json.bak"),
+    ] {
+        if let Ok(index) = read_json::<Index>(&path) {
+            for entry in index.playlists.values() {
+                keep.insert(entry.directory.clone());
+            }
+        }
+    }
+    if let Ok(record) = read_json::<SessionRecord>(&paths.root.join("playback.json")) {
+        if record.account_id == id && record.process.alive() {
+            keep.insert(record.directory);
+        }
+    }
+    let root = paths.account(id).join("generations");
+    if root.is_dir() {
+        for item in fs::read_dir(root)? {
+            let item = item?;
+            if item.file_type()?.is_dir()
+                && !keep.contains(&item.file_name().to_string_lossy().into_owned())
+            {
+                fs::remove_dir_all(item.path())?;
+            }
+        }
+    }
+    Ok(())
+}
+fn commit(
+    paths: &Paths,
+    id: &str,
+    uri: &str,
+    name: String,
+    snapshot: String,
+    library: &Library,
+    tracks: Vec<Track>,
+) -> Result<()> {
+    ensure!(account_id()?.as_deref() == Some(id), "account_changed");
+    commit_files(paths, id, uri, name, snapshot, library, tracks)
+}
+fn commit_files(
+    paths: &Paths,
+    id: &str,
+    uri: &str,
+    name: String,
+    snapshot: String,
+    library: &Library,
+    tracks: Vec<Track>,
+) -> Result<()> {
+    let directory = format!(
+        "{}-{:x}-{:x}",
+        hash(uri.as_bytes()),
+        now(),
+        rand::random::<u64>()
+    );
+    let generations = paths.account(id).join("generations");
+    fs::create_dir_all(&generations)?;
+    let entry = Entry {
+        directory: directory.clone(),
+        name,
+        snapshot_id: snapshot,
+        synced_at: now(),
+        bytes: tracks.iter().map(|t| t.bytes).sum(),
+        tracks,
+    };
+    select_complete(library, uri, &entry)?;
+    sync_dir(library.root())?;
+    fs::rename(library.root(), generations.join(&directory))?;
+    sync_dir(library.root().parent().context("pending parent")?)?;
+    sync_dir(&generations)?;
+    let mut index = load_index(paths, id)?;
+    index.playlists.insert(uri.into(), entry);
+    // Only this final atomic index update makes the new generation visible.
+    ensure!(
+        serde_json::to_vec(&index)?.len() as u64 <= MAX_JSON - 512,
+        "metadata_limit"
+    );
+    save_index(paths, &index)?;
+    sync_dir(&paths.root.join("accounts"))?;
+    sync_dir(&paths.root)
+}
+async fn synchronize(paths: &Paths, uri: &str) -> Result<()> {
+    let _lock = Lock::take(&paths.root.join("sync.lock"))?;
+    if let Ok(record) = read_json::<SessionRecord>(&paths.root.join("playback.json")) {
+        let paused = read_json::<serde_json::Value>(&record.status)
+            .is_ok_and(|status| status["phase"] == "paused");
+        ensure!(
+            !record.process.alive() || paused,
+            "busy: pause offline playback before synchronizing"
+        );
+    }
+    let id = account_id()?.context("authentication_required")?;
+    ensure!(
+        verified_account(paths, Some(&id)),
+        "authentication_required"
+    );
+    let stage = paths.pending(&id, uri);
+    let library = Library::new(stage.clone());
+    library.create()?;
+    let old = load_index(paths, &id)?;
+    if let Some(entry) = old.playlists.get(uri) {
+        reuse(&entry_library(paths, &id, entry)?, &stage)?;
+    }
+    for item in fs::read_dir(&stage)? {
+        let item = item?;
+        if item.file_name().to_string_lossy().starts_with(".tmp") && item.file_type()?.is_file() {
+            fs::remove_file(item.path())?;
+        }
+    }
+    let mut job = Job {
+        version: VERSION,
+        request: paths.request.clone(),
+        account_id: Some(id.clone()),
+        process: Process::current()?,
+        uri: uri.into(),
+        phase: "resolving".into(),
+        completed: 0,
+        total: 0,
+        bytes: 0,
+        tracks: Vec::new(),
+        error: None,
+    };
+    publish_job(paths, &job)?;
+    let result = async {
+        let auth = auth::AuthConfig {
+            cache: librespot_core::cache::Cache::new(
+                Some(config::get_config().cache_folder.clone()),
+                None,
+                None,
+                None,
+            )?,
+            login_redirect_uri: config::get_config().app_config.login_redirect_uri.clone(),
+        };
+        let session = auth.session();
+        let creds = auth::get_creds(&auth, false, true)?;
+        tokio::time::timeout(Duration::from_secs(30), session.connect(creds, true))
+            .await
+            .context("Spotify connection timeout")??;
+        let listing = super::native::listing(&session, uri).await?;
+        ensure!(!listing.uris.is_empty(), "empty_playlist");
+        ensure!(
+            listing.uris.iter().all(|s| s.starts_with("spotify:track:")),
+            "unsupported_item"
+        );
+        let expected = listing.uris.clone();
+        let mut completed_tracks = Vec::with_capacity(expected.len());
+        job.total = expected.len();
+        job.phase = "downloading".into();
+        publish_job(paths, &job)?;
+        let downloaded = async {
+            for (index, track_uri) in expected.iter().enumerate() {
+                ensure!(account_id()?.as_deref() == Some(&id), "account_changed");
+                if !library.contains_valid(track_uri) {
+                    super::download_checked(&session, &library, track_uri, |bytes| {
+                        check_capacity(paths, bytes)
+                    })
+                    .await?;
+                }
+                let saved = library.track(track_uri)?;
+                if !saved
+                    .cover_url
+                    .as_deref()
+                    .is_none_or(|url| library.cover_is_valid(url))
+                {
+                    super::download_cover(&library, saved.cover_url.as_deref()).await?;
+                }
+                library.verify_cover(&saved)?;
+                job.bytes += saved.bytes;
+                let metadata = Track::from(saved);
+                if index < super::native::PAGE_SIZE {
+                    job.tracks.push(metadata.clone());
+                }
+                completed_tracks.push(metadata);
+                job.completed = index + 1;
+                publish_job(paths, &job)?;
+                tokio::time::sleep(Duration::from_millis(500)).await;
+            }
+            Result::<()>::Ok(())
+        }
+        .await;
+        downloaded?;
+        job.phase = "verifying".into();
+        publish_job(paths, &job)?;
+        for track in &completed_tracks {
+            ensure!(library.contains_valid(&track.uri), "incomplete_snapshot");
+        }
+        let after = super::native::listing(&session, uri).await?;
+        session.shutdown();
+        ensure!(
+            listing.revision == after.revision && expected == after.uris,
+            "playlist_changed"
+        );
+        prune_stage(&library, &expected)?;
+        library.save_collection(uri, &expected)?;
+        commit(
+            paths,
+            &id,
+            uri,
+            listing.name,
+            listing.revision,
+            &library,
+            completed_tracks,
+        )?;
+        publish_catalog(paths, None)?;
+        job.phase = "complete".into();
+        publish_job(paths, &job)
+    }
+    .await;
+    if let Err(error) = &result {
+        job.phase = "error".into();
+        job.error = Some(error_code(error).into());
+        if serde_json::to_vec(&job).map_or(true, |bytes| bytes.len() as u64 > MAX_JSON) {
+            job.tracks.clear();
+        }
+        let _ = publish_job(paths, &job);
+        let _ = publish_catalog(paths, None);
+        let _ = fs::write(paths.root.join("last-error.log"), format!("{error:#}\n"));
+    }
+    if result.is_ok() {
+        let _ = cleanup_generations(paths, &id);
+    }
+    result
+}
+fn error_code(error: &anyhow::Error) -> &'static str {
+    let text = format!("{error:#}");
+    if error
+        .chain()
+        .filter_map(|e| e.downcast_ref::<std::io::Error>())
+        .any(|e| e.raw_os_error() == Some(rustix::io::Errno::NOSPC.raw_os_error()))
+        || text.contains("storage_full")
+    {
+        "storage_full"
+    } else if text.contains("account_changed") {
+        "account_changed"
+    } else if text.contains("authentication_required")
+        || text.contains("cached credentials")
+        || text.contains("BadCredentials")
+        || text.contains("401 Unauthorized")
+    {
+        "authentication_required"
+    } else if text.contains("playlist_changed") {
+        "playlist_changed"
+    } else if text.contains("429") || text.contains("rate limit") {
+        "rate_limited"
+    } else if text.contains("unsupported_item") {
+        "unsupported_item"
+    } else if text.contains("unsupported_audio_format") {
+        "unsupported_audio_format"
+    } else if text.contains("playlist_incomplete") {
+        "playlist_incomplete"
+    } else if text.contains("playlist_too_large") {
+        "playlist_too_large"
+    } else if text.contains("timed out") || text.contains("timeout") {
+        "network_timeout"
+    } else if text.contains("unavailable in your market") || text.contains("track_unavailable") {
+        "track_unavailable"
+    } else if text.contains("unsupported_playlist") || text.contains("metadata_limit") {
+        "unsupported_playlist"
+    } else if text.contains("busy:") {
+        "busy"
+    } else {
+        "download_failed"
+    }
+}
+fn send_stop(record: &SessionRecord) -> Result<()> {
+    let data = read_json::<serde_json::Value>(&record.control).unwrap_or_default();
+    let id = data["commands"]
+        .as_array()
+        .into_iter()
+        .flatten()
+        .filter_map(|c| c["id"].as_u64())
+        .max()
+        .unwrap_or(0)
+        .saturating_add(1);
+    write_json(
+        &record.control,
+        &serde_json::json!({"session":record.session,"commands":[{"id":id,"action":"stop"}]}),
+    )
+}
+fn take_playback(paths: &Paths) -> Result<Lock> {
+    if let Ok(lock) = Lock::take(&paths.root.join("playback.lock")) {
+        return Ok(lock);
+    }
+    if let Ok(record) = read_json::<SessionRecord>(&paths.root.join("playback.json")) {
+        if record.process.alive() {
+            send_stop(&record)?;
+        }
+    }
+    let start = Instant::now();
+    while start.elapsed() < Duration::from_secs(4) {
+        if let Ok(lock) = Lock::take(&paths.root.join("playback.lock")) {
+            return Ok(lock);
+        }
+        std::thread::sleep(Duration::from_millis(100));
+    }
+    bail!("busy: previous offline playback has not stopped")
+}
+fn same_account(id: &str) -> bool {
+    account_id().is_ok_and(|current| current.as_deref() == Some(id))
+}
+fn resume_path(paths: &Paths, id: &str, uri: &str) -> PathBuf {
+    paths
+        .account(id)
+        .join("resume")
+        .join(hash(uri.as_bytes()) + ".json")
+}
+fn save_resume(
+    paths: &Paths,
+    record: &SessionRecord,
+    tracks: &[Download],
+    status: &player::Status,
+) {
+    if let Some(track) = status.current.and_then(|i| tracks.get(i)) {
+        let _ = write_json(
+            &resume_path(paths, &record.account_id, &record.uri),
+            &Resume {
+                account_id: record.account_id.clone(),
+                uri: record.uri.clone(),
+                track_uri: track.uri.clone(),
+                position_ms: status.position_ms,
+            },
+        );
+    }
+}
+fn run_playback(paths: &Paths, args: &ArgMatches, uri: &str) -> Result<()> {
+    let session = args
+        .get_one::<String>("session")
+        .context("missing session")?;
+    ensure!(
+        !session.is_empty()
+            && session.len() <= 64
+            && session.bytes().all(|c| c.is_ascii_digit() || c == b'-'),
+        "invalid session identifier"
+    );
+    let id = account_id()?.context("authentication_required")?;
+    let _lock = take_playback(paths)?;
+    let index = load_index(paths, &id)?;
+    let entry = index.playlists.get(uri).context("no_complete_snapshot")?;
+    let library = entry_library(paths, &id, entry)?;
+    let tracks = select_complete(&library, uri, entry)?;
+    let mut initial = *args
+        .get_one::<usize>("index")
+        .context("missing track index")?;
+    let mut seek_ms = 0;
+    if args.get_flag("resume") {
+        if let Ok(saved) = read_json::<Resume>(&resume_path(paths, &id, uri)) {
+            if saved.account_id == id && saved.uri == uri {
+                if let Some(i) = tracks.iter().position(|t| t.uri == saved.track_uri) {
+                    initial = i;
+                    seek_ms = saved
+                        .position_ms
+                        .min(tracks[i].duration_ms.saturating_sub(1));
+                }
+            }
+        }
+    }
+    ensure!(initial < tracks.len(), "invalid track index");
+    let record = SessionRecord {
+        process: Process::current()?,
+        session: session.clone(),
+        uri: uri.into(),
+        account_id: id,
+        directory: entry.directory.clone(),
+        control: args
+            .get_one::<String>("control")
+            .context("missing control path")?
+            .into(),
+        status: args
+            .get_one::<String>("status")
+            .context("missing status path")?
+            .into(),
+    };
+    write_json(&paths.root.join("playback.json"), &record)?;
+    let status = Arc::new(Mutex::new(player::Status {
+        current: None,
+        position_ms: 0,
+        playing: false,
+        ended: false,
+        volume: 100,
+        error: None,
+    }));
+    let (sender, receiver) = flume::unbounded();
+    let worker_status = status.clone();
+    let worker_library = library.clone();
+    let worker_tracks = tracks.clone();
+    let worker = std::thread::Builder::new()
+        .name("offline-audio".into())
+        .spawn(move || {
+            if let Err(error) =
+                player::audio_loop(&worker_library, &worker_tracks, &receiver, &worker_status)
+            {
+                let mut state = worker_status.lock();
+                state.error = Some(format!("{error:#}"));
+                state.playing = false;
+            }
+        })?;
+    let _ = sender.send(player::Control::Play(initial));
+    if seek_ms > 0 {
+        let _ = sender.send(player::Control::Seek(i64::from(seek_ms)));
+    }
+    let mut ack = 0;
+    let mut started = false;
+    let mut stopped = false;
+    let mut last_resume = Instant::now();
+    let mut last_saved_state = None;
+    let mut last_publish = Instant::now()
+        .checked_sub(Duration::from_secs(1))
+        .unwrap_or_else(Instant::now);
+    let result: Result<()> = (|| {
+        loop {
+            if !same_account(&record.account_id) {
+                bail!("account_changed");
+            }
+            if let Ok(controls) = read_json::<Controls>(&record.control) {
+                if controls.session == record.session && controls.commands.len() <= 64 {
+                    for command in controls.commands {
+                        if command.id <= ack {
+                            continue;
+                        }
+                        let control = match command.action.as_str() {
+                            "stop" => {
+                                stopped = true;
+                                Some(player::Control::Stop)
+                            }
+                            "pause" => Some(player::Control::PlayState(false)),
+                            "resume" => Some(player::Control::PlayState(true)),
+                            "next" => Some(player::Control::NextBounded),
+                            "prev" => Some(player::Control::PreviousOrRestart),
+                            "seek" => command.value.map(|ms| {
+                                player::Control::SeekTo(ms.clamp(0, i64::from(u32::MAX)) as u32)
+                            }),
+                            "skip" => command.value.map(|seconds| {
+                                player::Control::Seek(seconds.clamp(-86400, 86400) * 1000)
+                            }),
+                            _ => None,
+                        };
+                        if let Some(control) = control {
+                            let _ = sender.send(control);
+                        }
+                        ack = command.id;
+                    }
+                }
+            }
+            let state = status.lock().clone();
+            started |= state.current.is_some();
+            if last_publish.elapsed() >= Duration::from_millis(500) {
+                write_json(
+                    &record.status,
+                    &Playback {
+                        version: VERSION,
+                        track: state
+                            .current
+                            .and_then(|i| tracks.get(i))
+                            .cloned()
+                            .map(Track::from),
+                        process: record.process.clone(),
+                        session: record.session.clone(),
+                        phase: if state.error.is_some() {
+                            "error"
+                        } else if state.ended {
+                            "ended"
+                        } else if state.playing {
+                            "playing"
+                        } else if started {
+                            "paused"
+                        } else {
+                            "starting"
+                        }
+                        .into(),
+                        index: state.current.unwrap_or(initial),
+                        position_ms: state.position_ms,
+                        ack,
+                        error: state.error.as_ref().map(|_| "audio_error".into()),
+                    },
+                )?;
+                last_publish = Instant::now();
+            }
+            let resume_state = (state.current, state.playing, state.ended);
+            if last_saved_state != Some(resume_state)
+                || last_resume.elapsed() >= Duration::from_secs(15)
+            {
+                save_resume(paths, &record, &tracks, &state);
+                last_resume = Instant::now();
+                last_saved_state = Some(resume_state);
+            }
+            if stopped || state.error.is_some() {
+                break;
+            }
+            // At the end the worker drops the decoder and keeps the final position.
+            if state.ended {
+                break;
+            }
+            std::thread::sleep(Duration::from_millis(100));
+        }
+        Ok(())
+    })();
+    let _ = sender.send(player::Control::Stop);
+    let joined = worker.join();
+    let final_state = status.lock().clone();
+    save_resume(paths, &record, &tracks, &final_state);
+    write_json(
+        &record.status,
+        &Playback {
+            version: VERSION,
+            track: final_state
+                .current
+                .and_then(|i| tracks.get(i))
+                .cloned()
+                .map(Track::from),
+            process: record.process.clone(),
+            session: record.session.clone(),
+            phase: if result.is_err() || final_state.error.is_some() {
+                "error"
+            } else if stopped {
+                "stopped"
+            } else {
+                "ended"
+            }
+            .into(),
+            index: final_state.current.unwrap_or(initial),
+            position_ms: final_state.position_ms,
+            ack,
+            error: if result.is_err() {
+                Some("account_changed".into())
+            } else {
+                final_state.error.as_ref().map(|_| "audio_error".into())
+            },
+        },
+    )?;
+    result?;
+    ensure!(joined.is_ok(), "audio_worker_failed");
+    ensure!(final_state.error.is_none(), "audio_error");
+    Ok(())
+}
+fn remove(paths: &Paths, uri: &str) -> Result<()> {
+    let _lock = Lock::take(&paths.root.join("sync.lock"))?;
+    if let Ok(record) = read_json::<SessionRecord>(&paths.root.join("playback.json")) {
+        ensure!(
+            !record.process.alive() || record.uri != uri,
+            "busy: snapshot is playing"
+        );
+    }
+    let id = account_id()?.context("authentication_required")?;
+    let mut index = load_index(paths, &id)?;
+    if let Some(entry) = index.playlists.remove(uri) {
+        let dir = entry_library(paths, &id, &entry)?.root().to_path_buf();
+        save_index(paths, &index)?;
+        fs::remove_dir_all(dir)?;
+    }
+    let pending = paths.pending(&id, uri);
+    if pending.exists() {
+        fs::remove_dir_all(pending)?;
+    }
+    let _ = write_json(&index_path(paths, &id).with_extension("json.bak"), &index);
+    let prefix = hash(uri.as_bytes()) + "-";
+    let generations = paths.account(&id).join("generations");
+    if generations.is_dir() {
+        for item in fs::read_dir(generations)? {
+            let item = item?;
+            if item.file_type()?.is_dir() && item.file_name().to_string_lossy().starts_with(&prefix)
+            {
+                fs::remove_dir_all(item.path())?;
+            }
+        }
+    }
+    publish_catalog(paths, None)
+}
+fn wait_auth_lock(paths: &Paths) -> Result<Lock> {
+    let start = Instant::now();
+    loop {
+        match Lock::take(&paths.root.join("auth.lock")) {
+            Ok(lock) => return Ok(lock),
+            Err(error) if start.elapsed() >= Duration::from_secs(12) => return Err(error),
+            Err(_) => std::thread::sleep(Duration::from_millis(50)),
+        }
+    }
+}
+fn stop_operation(path: &Path) -> Result<Lock> {
+    let start = Instant::now();
+    loop {
+        if let Ok(lock) = Lock::take(path) {
+            return Ok(lock);
+        }
+        if let Ok(process) = read_json::<Process>(path) {
+            if process.pid != std::process::id() && process.alive() {
+                if let Some(pid) = rustix::process::Pid::from_raw(process.pid as i32) {
+                    let _ = rustix::process::kill_process(pid, rustix::process::Signal::TERM);
+                }
+            }
+        }
+        ensure!(
+            start.elapsed() < Duration::from_secs(3),
+            "busy: owned operation has not stopped"
+        );
+        std::thread::sleep(Duration::from_millis(50));
+    }
+}
+fn swap_cache(cache: &Path, stage: &Path, old: &Path) -> Result<()> {
+    ensure!(!old.exists(), "activation_failed: backup already exists");
+    let had_cache = cache.exists();
+    if had_cache {
+        fs::rename(cache, old)?;
+    }
+    if let Err(error) = fs::rename(stage, cache) {
+        if had_cache {
+            fs::rename(old, cache).context("restore previous credentials")?;
+        }
+        return Err(error).context("activate credentials");
+    }
+    if let Err(error) = sync_dir(cache.parent().context("cache parent")?) {
+        fs::rename(cache, stage)?;
+        if had_cache {
+            fs::rename(old, cache)?;
+        }
+        return Err(error);
+    }
+    Ok(())
+}
+fn activation_matches(marker: &Path, request: &str) -> Result<()> {
+    ensure!(
+        !request.is_empty()
+            && request.len() <= 64
+            && request.bytes().all(|b| b.is_ascii_digit() || b == b'-'),
+        "invalid authentication request"
+    );
+    ensure!(
+        fs::metadata(marker)?.len() <= 64 && fs::read_to_string(marker)? == request,
+        "authentication_cancelled"
+    );
+    Ok(())
+}
+fn activate_login(paths: &Paths, marker: &Path) -> Result<()> {
+    let _auth = wait_auth_lock(paths)?;
+    activation_matches(marker, &paths.request)?;
+    let cache = &config::get_config().cache_folder;
+    let parent = cache.parent().context("cache parent")?;
+    let stage = parent.join("auth-stage").join(&paths.request).join("cache");
+    let info: serde_json::Value = read_json(&stage.join("offline-account.json"))?;
+    let username = info["username"]
+        .as_str()
+        .context("invalid account identity")?;
+    ensure!(
+        info["request"] == paths.request
+            && info["account_id"] == hash(username.as_bytes())
+            && info["metadata_ready"] == true,
+        "invalid account identity"
+    );
+    let _sync = stop_operation(&paths.root.join("sync.lock"))?;
+    let _preview = stop_operation(&paths.root.join("preview.lock"))?;
+    let _playback = take_playback(paths)?;
+    activation_matches(marker, &paths.request)?;
+    let old = parent.join(format!("cache-old-{}", paths.request));
+    swap_cache(cache, &stage, &old)?;
+    if let Err(error) =
+        activation_matches(marker, &paths.request).and_then(|()| publish_catalog(paths, None))
+    {
+        fs::rename(cache, &stage)?;
+        if old.exists() {
+            fs::rename(&old, cache)?;
+        }
+        return Err(error);
+    }
+    if old.exists() {
+        let _ = fs::remove_dir_all(old);
+    }
+    Ok(())
+}
+fn cancel_login(paths: &Paths) -> Result<()> {
+    let _auth = wait_auth_lock(paths)?;
+    let request = &paths.request;
+    ensure!(
+        !request.is_empty()
+            && request.len() <= 64
+            && request.bytes().all(|b| b.is_ascii_digit() || b == b'-'),
+        "invalid authentication request"
+    );
+    let stage = config::get_config()
+        .cache_folder
+        .parent()
+        .context("cache parent")?
+        .join("auth-stage")
+        .join(request);
+    if stage.exists() {
+        fs::remove_dir_all(stage)?;
+    }
+    Ok(())
+}
+fn forget(paths: &Paths) -> Result<()> {
+    let _auth = wait_auth_lock(paths)?;
+    let _sync = stop_operation(&paths.root.join("sync.lock"))?;
+    let _preview = stop_operation(&paths.root.join("preview.lock"))?;
+    let _playback = take_playback(paths)?;
+    let cache = &config::get_config().cache_folder;
+    for name in [
+        "credentials.json".to_owned(),
+        "offline-account.json".to_owned(),
+        format!("{}_token.json", auth::NCSPOT_CLIENT_ID),
+    ] {
+        let path = cache.join(name);
+        if path.exists() {
+            fs::remove_file(path)?;
+        }
+    }
+    let stages = cache.parent().context("cache parent")?.join("auth-stage");
+    if stages.exists() {
+        fs::remove_dir_all(stages)?;
+    }
+    publish_catalog(paths, None)
+}
+
+fn login_metadata() -> Result<()> {
+    tokio::runtime::Runtime::new()?.block_on(async {
+        let client = AppClient::metadata_login().await?;
+        let user = client.current_user().await?;
+        let user_id = user.id.id().to_owned();
+        let info = serde_json::json!({"version":1,"username":user_id,"account_id":hash(user_id.as_bytes()),"metadata_ready":true,"premium":false});
+        write_json(&config::get_config().cache_folder.join("offline-account.json"), &info)?;
+        serde_json::to_writer(std::io::stdout().lock(), &info)?;
+        Result::<()>::Ok(())
+    })
+}
+
+fn login_native(interactive: bool) -> Result<()> {
+    let auth = auth::AuthConfig::new(config::get_config())?;
+    let creds = auth::get_creds(&auth, interactive, !interactive)?;
+    let rt = tokio::runtime::Runtime::new()?;
+    rt.block_on(async {
+        let session = auth.session();
+        tokio::time::timeout(Duration::from_secs(30), session.connect(creds, true)).await??;
+        let start = Instant::now();
+        while session.get_user_attribute("type").is_none()
+            && start.elapsed() < Duration::from_secs(10)
+        {
+            tokio::time::sleep(Duration::from_millis(100)).await;
+        }
+        ensure!(
+            session.get_user_attribute("type").as_deref() == Some("premium"),
+            "premium_required"
+        );
+        let user = session.username();
+        let mut info = account_info();
+        if !info.is_object() {
+            info = serde_json::json!({});
+        }
+        if let Some(old_user) = info["username"].as_str() {
+            ensure!(
+                old_user == user,
+                "account_changed: use the same account for both permissions"
+            );
+        }
+        info["version"] = VERSION.into();
+        info["username"] = user.clone().into();
+        info["account_id"] = hash(user.as_bytes()).into();
+        info["premium"] = true.into();
+        info["metadata_ready"] = true.into();
+        write_json(
+            &config::get_config()
+                .cache_folder
+                .join("offline-account.json"),
+            &info,
+        )?;
+        session.shutdown();
+        serde_json::to_writer(std::io::stdout().lock(), &info)?;
+        Result::<()>::Ok(())
+    })
+}
+#[derive(Serialize, Deserialize)]
+struct Preview {
+    version: u32,
+    #[serde(default)]
+    metadata_version: u32,
+    account_id: String,
+    request: String,
+    uri: String,
+    phase: String,
+    offset: usize,
+    total: usize,
+    name: String,
+    tracks: Vec<super::native::Song>,
+    error: Option<String>,
+}
+async fn preview_native(paths: &Paths, args: &ArgMatches, uri: &str) -> Result<()> {
+    let _lock = Lock::take(&paths.root.join("preview.lock"))?;
+    let id = account_id()?.context("authentication_required")?;
+    let output = Path::new(args.get_one::<String>("output").context("missing output")?);
+    let offset = *args.get_one::<usize>("offset").context("missing offset")?;
+    let mut result = Preview {
+        version: VERSION,
+        metadata_version: 2,
+        account_id: id.clone(),
+        request: paths.request.clone(),
+        uri: uri.into(),
+        phase: "loading".into(),
+        offset,
+        total: 0,
+        name: String::new(),
+        tracks: Vec::new(),
+        error: None,
+    };
+    write_public(output, &result)?;
+    let cache = paths
+        .account(&id)
+        .join("previews")
+        .join(hash(uri.as_bytes()))
+        .join(format!("{offset}.json"));
+    let attempt: Result<()> = async {
+        if let Some(entry) = load_index(paths, &id)?.playlists.get(uri) {
+            result.total = entry.tracks.len();
+            result.name.clone_from(&entry.name);
+            result.tracks = entry
+                .tracks
+                .iter()
+                .skip(offset)
+                .take(super::native::PAGE_SIZE)
+                .map(|t| super::native::Song {
+                    uri: t.uri.clone(),
+                    name: t.name.clone(),
+                    artists: t.artists.clone(),
+                    album: t.album.clone(),
+                    duration_ms: t.duration_ms,
+                    bytes: t.bytes,
+                    problem: None,
+                })
+                .collect();
+            return Ok(());
+        }
+        if let Ok(saved) = read_json::<Preview>(&cache) {
+            if saved.account_id == id && saved.phase == "complete" {
+                result.name = saved.name;
+                result.total = saved.total;
+                result.tracks = saved.tracks;
+                let fresh = fs::metadata(&cache)
+                    .and_then(|m| m.modified())
+                    .ok()
+                    .and_then(|t| t.elapsed().ok())
+                    .is_some_and(|age| age < Duration::from_secs(300))
+                    && saved.metadata_version == 2;
+                if fresh {
+                    return Ok(());
+                }
+                write_public(output, &result)?;
+            }
+        }
+        if !verified_account(paths, Some(&id)) {
+            ensure!(metadata_ready(paths, Some(&id)), "authentication_required");
+            let client = AppClient::cached().await?;
+            let page = client
+                .playlist_metadata_page(rspotify::model::PlaylistId::from_uri(uri)?, offset)
+                .await?;
+            result.total = page.total as usize;
+            result.tracks = page
+                .items
+                .into_iter()
+                .map(|row| match row.item {
+                    Some(rspotify::model::PlayableItem::Track(t)) => super::native::Song {
+                        uri: t.id.map(|id| id.uri()).unwrap_or_default(),
+                        name: t.name,
+                        artists: t.artists.into_iter().map(|a| a.name).collect(),
+                        album: t.album.name,
+                        duration_ms: t.duration.num_milliseconds().max(0) as u32,
+                        bytes: 0,
+                        problem: None,
+                    },
+                    Some(rspotify::model::PlayableItem::Episode(e)) => super::native::Song {
+                        uri: e.id.uri(),
+                        name: e.name,
+                        artists: vec![e.show.name.clone()],
+                        album: e.show.name,
+                        duration_ms: e.duration.num_milliseconds().max(0) as u32,
+                        bytes: 0,
+                        problem: Some("unsupported_item".into()),
+                    },
+                    _ => super::native::Song {
+                        uri: String::new(),
+                        name: "Unavailable item".into(),
+                        artists: Vec::new(),
+                        album: String::new(),
+                        duration_ms: 0,
+                        bytes: 0,
+                        problem: Some("metadata_unavailable".into()),
+                    },
+                })
+                .collect();
+            return Ok(());
+        }
+        let auth = auth::AuthConfig::new(config::get_config())?;
+        let session = auth.session();
+        let creds = auth::get_creds(&auth, false, true)?;
+        tokio::time::timeout(Duration::from_secs(30), session.connect(creds, true)).await??;
+        let listing = super::native::listing(&session, uri).await?;
+        result.total = listing.uris.len();
+        result.name = listing.name;
+        result.tracks.clear();
+        for uri in listing
+            .uris
+            .iter()
+            .skip(offset)
+            .take(super::native::PAGE_SIZE)
+        {
+            match super::native::song(&session, uri).await {
+                Ok(song) => result.tracks.push(song),
+                Err(_) => result.tracks.push(super::native::Song {
+                    uri: uri.clone(),
+                    name: uri.clone(),
+                    artists: Vec::new(),
+                    album: String::new(),
+                    duration_ms: 0,
+                    bytes: 0,
+                    problem: Some("metadata_unavailable".into()),
+                }),
+            }
+            if result.tracks.len().is_multiple_of(5) {
+                write_public(output, &result)?;
+            }
+        }
+        session.shutdown();
+        Ok(())
+    }
+    .await;
+    result.phase = if attempt.is_ok() { "complete" } else { "error" }.into();
+    result.error = attempt.as_ref().err().map(|e| error_code(e).into());
+    if attempt.is_ok() {
+        let _ = write_json(&cache, &result);
+    }
+    write_public(output, &result)?;
+    attempt
+}
+
+async fn inspect_native(uri: &str) -> Result<()> {
+    use librespot_metadata::Metadata as _;
+    let auth = auth::AuthConfig::new(config::get_config())?;
+    let session = auth.session();
+    let creds = auth::get_creds(&auth, false, true)?;
+    tokio::time::timeout(Duration::from_secs(30), session.connect(creds, true)).await??;
+    let playlist = librespot_metadata::playlist::Playlist::get(
+        &session,
+        &librespot_core::SpotifyUri::from_uri(uri)?,
+    )
+    .await?;
+    let uris = playlist
+        .tracks()
+        .map(librespot_core::SpotifyUri::to_uri)
+        .collect::<std::result::Result<Vec<_>, _>>()?;
+    session.shutdown();
+    serde_json::to_writer(
+        std::io::stdout().lock(),
+        &serde_json::json!({"name": playlist.name(), "total": playlist.length, "truncated": playlist.contents.is_truncated, "position": playlist.contents.position, "uris": uris}),
+    )?;
+    Ok(())
+}
+
+pub fn handle(args: &ArgMatches) -> Result<()> {
+    rustix::process::umask(rustix::fs::Mode::from_raw_mode(0o077));
+    let paths = Paths {
+        request: args
+            .get_one::<String>("request")
+            .cloned()
+            .unwrap_or_default(),
+        root: args
+            .get_one::<String>("store")
+            .context("missing store")?
+            .into(),
+        catalog: args
+            .get_one::<String>("catalog")
+            .context("missing catalog")?
+            .into(),
+        job: args.get_one::<String>("job").context("missing job")?.into(),
+        quota: *args
+            .get_one::<u64>("quota-bytes")
+            .context("missing quota")?,
+    };
+    fs::create_dir_all(&paths.root)?;
+    let tmp = paths.root.join("tmp");
+    fs::create_dir_all(&tmp)?;
+    std::env::set_var("TMPDIR", &tmp);
+    let (command, sub) = args.subcommand().context("managed command required")?;
+    let uri = sub
+        .try_get_one::<String>("uri")
+        .ok()
+        .flatten()
+        .map(|s| super::parse_source(s))
+        .transpose()?;
+    if let Some(uri) = &uri {
+        ensure!(
+            uri.starts_with("spotify:playlist:"),
+            "managed playlists only"
+        );
+    }
+    let result = match command {
+        "activate-login" => activate_login(
+            &paths,
+            Path::new(
+                sub.get_one::<String>("marker")
+                    .context("missing authentication marker")?,
+            ),
+        ),
+        "cancel-login" => cancel_login(&paths),
+        "metadata-login" => login_metadata(),
+        "login" => login_native(true),
+        "verify-login" => login_native(false),
+        "preview" => tokio::runtime::Runtime::new()?.block_on(preview_native(
+            &paths,
+            sub,
+            uri.as_deref().context("missing playlist")?,
+        )),
+        "catalog" => {
+            recover_job(&paths)?;
+            publish_catalog(&paths, None)
+        }
+        "inspect" => tokio::runtime::Runtime::new()?
+            .block_on(inspect_native(uri.as_deref().context("missing playlist")?)),
+        "sync" => tokio::runtime::Runtime::new()?.block_on(synchronize(
+            &paths,
+            uri.as_deref().context("missing playlist")?,
+        )),
+        "play" => run_playback(&paths, sub, uri.as_deref().context("missing playlist")?),
+        "remove" => remove(&paths, uri.as_deref().context("missing playlist")?),
+        "forget" => forget(&paths),
+        _ => bail!("unknown managed command"),
+    };
+    if let Err(error) = &result {
+        let code = error_code(error);
+        let _ = write_json(
+            &paths.root.join("last-error.json"),
+            &serde_json::json!({"code":code,"detail":format!("{error:#}")}),
+        );
+        let already_reported = read_json::<Job>(&paths.job).is_ok_and(|job| {
+            job.request == paths.request
+                && job.uri == uri.as_deref().unwrap_or_default()
+                && job.phase == "error"
+        });
+        if command == "sync" && code != "busy" && !already_reported {
+            if let Some(uri) = &uri {
+                let _ = publish_job(
+                    &paths,
+                    &Job {
+                        version: VERSION,
+                        request: paths.request.clone(),
+                        account_id: account_id().ok().flatten(),
+                        process: Process::current()?,
+                        uri: uri.clone(),
+                        phase: "error".into(),
+                        completed: 0,
+                        total: 0,
+                        bytes: 0,
+                        tracks: Vec::new(),
+                        error: Some(code.into()),
+                    },
+                );
+            }
+        }
+        if command == "play" {
+            if let (Some(session), Some(path)) = (
+                sub.get_one::<String>("session"),
+                sub.get_one::<String>("status"),
+            ) {
+                let _ = write_json(
+                    Path::new(path),
+                    &Playback {
+                        version: VERSION,
+                        track: None,
+                        process: Process::current()?,
+                        session: session.clone(),
+                        phase: "error".into(),
+                        index: 0,
+                        position_ms: 0,
+                        ack: 0,
+                        error: Some(code.into()),
+                    },
+                );
+            }
+        }
+        let _ = publish_catalog(&paths, Some(code));
+    }
+    result
+}
