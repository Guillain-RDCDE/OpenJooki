+    }
+    #[test]
+    fn quota_failure_keeps_the_index_and_the_old_download_readable() {
+        let root = tempfile::tempdir().unwrap();
+        let mut p = paths(root.path());
+        let lib = stage(&p);
+        let a = fixture(&lib, "1111111111111111111111", "First");
