+    fn fixture(library: &Library, id: &str, name: &str) -> Track {
+        library.create().unwrap();
+        let key = [42; 16];
+        let mut plain = vec![0; 167];
+        plain.extend_from_slice(include_bytes!("testdata/silence.ogg"));
+        let mut encrypted = Vec::new();
+        AudioDecrypt::new(Some(AudioKey(key)), plain.as_slice())
+            .read_to_end(&mut encrypted)
+            .unwrap();
+        let track = Download {
+            version: 1,
+            uri: format!("spotify:track:{id}"),
+            name: name.into(),
+            artists: vec!["Test".into()],
+            album: "Fixture".into(),
+            cover_url: None,
+            duration_ms: 120,
+            key,
+            bytes: encrypted.len() as u64,
+            sha256: String::new(),
+        };
+        library.save(track.clone(), encrypted.as_slice()).unwrap();
+        Track::from(track)
+    }
+    fn stage(paths: &Paths) -> Library {
+        Library::new(paths.pending(ACCOUNT, URI))
+    }
+    fn publish(paths: &Paths, tracks: Vec<Track>) -> Result<()> {
+        let lib = stage(paths);
+        lib.save_collection(
+            URI,
+            &tracks.iter().map(|t| t.uri.clone()).collect::<Vec<_>>(),
+        )?;
+        commit_files(
+            paths,
+            ACCOUNT,
+            URI,
+            "Test".into(),
+            "snapshot".into(),
+            &lib,
+            tracks,
+        )
+    }
+    #[test]
+    fn failed_update_retains_exact_previous_generation_and_order() {
+        let root = tempfile::tempdir().unwrap();
+        let p = paths(root.path());
