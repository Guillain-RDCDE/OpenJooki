+struct Lock {
+    _file: File,
+}
+impl Lock {
+    fn take(path: &Path) -> Result<Self> {
+        let mut file = OpenOptions::new()
+            .read(true)
+            .write(true)
+            .create(true)
+            .truncate(false)
+            .open(path)?;
+        // Keep the same inode: replacing a live flock file would permit a second owner.
+        rustix::fs::flock(&file, rustix::fs::FlockOperation::NonBlockingLockExclusive)
+            .context("busy: another managed operation owns the lock")?;
+        file.set_len(0)?;
+        serde_json::to_writer(&mut file, &Process::current()?)?;
+        file.flush()?;
+        Ok(Self { _file: file })
+    }
+}
+impl Process {
+    fn current() -> Result<Self> {
+        let pid = std::process::id();
+        Ok(Self {
+            pid,
+            executable: std::env::current_exe()?,
+            start: process_start(pid),
+        })
+    }
+    fn alive(&self) -> bool {
+        if self.pid <= 1 || self.pid > i32::MAX as u32 {
+            return false;
+        }
+        let Some(pid) = rustix::process::Pid::from_raw(self.pid as i32) else {
+            return false;
+        };
+        if rustix::process::test_kill_process(pid).is_err() {
+            return false;
+        }
+        if cfg!(target_os = "linux") {
+            return self.start.is_some()
+                && process_start(self.pid) == self.start
+                && fs::read_link(format!("/proc/{}/exe", self.pid))
+                    .is_ok_and(|p| p == self.executable);
+        }
+        true
+    }
+}
+fn process_start(pid: u32) -> Option<String> {
+    let text = fs::read_to_string(format!("/proc/{pid}/stat")).ok()?;
+    text.rsplit_once(')')?
+        .1
+        .split_whitespace()
+        .nth(19)
+        .map(str::to_owned)
+}
+fn now() -> u64 {
+    SystemTime::now()
+        .duration_since(UNIX_EPOCH)
+        .unwrap_or_default()
+        .as_secs()
+}
+fn hash(bytes: &[u8]) -> String {
+    use std::fmt::Write as _;
+    Sha256::digest(bytes)
+        .iter()
+        .fold(String::with_capacity(64), |mut out, byte| {
+            let _ = write!(out, "{byte:02x}");
+            out
+        })
+}
+
+fn read_json<T: DeserializeOwned>(path: &Path) -> Result<T> {
+    let file = File::open(path)?;
+    ensure!(
+        file.metadata()?.len() <= MAX_JSON,
+        "managed JSON is too large"
+    );
+    Ok(serde_json::from_reader(file)?)
+}
+fn sync_dir(path: &Path) -> Result<()> {
+    File::open(path)?.sync_all()?;
+    Ok(())
+}
+
+fn write_json(path: &Path, value: &impl Serialize) -> Result<()> {
+    let dir = path.parent().context("missing status directory")?;
+    fs::create_dir_all(dir)?;
+    let mut file = tempfile::NamedTempFile::new_in(dir)?;
+    let bytes = serde_json::to_vec(value)?;
+    ensure!(bytes.len() as u64 <= MAX_JSON, "metadata_limit");
+    file.write_all(&bytes)?;
+    file.write_all(b"\n")?;
+    file.as_file().sync_all()?;
+    file.persist(path)?;
+    sync_dir(dir)
+}
+fn free_bytes(root: &Path) -> Result<u64> {
+    let stat = rustix::fs::statvfs(root)?;
+    Ok(stat.f_bavail.saturating_mul(stat.f_frsize))
+}
+
+fn used_bytes(root: &Path) -> Result<u64> {
+    fn visit(root: &Path, seen: &mut HashSet<(u64, u64)>) -> Result<u64> {
+        let mut total = 0;
+        for item in fs::read_dir(root)? {
+            let item = item?;
+            let meta = fs::symlink_metadata(item.path())?;
+            if meta.is_dir() {
+                total += visit(&item.path(), seen)?;
+            } else if meta.is_file() && seen.insert((meta.dev(), meta.ino())) {
+                total += meta.len();
+            }
+        }
+        Ok(total)
+    }
+    visit(root, &mut HashSet::new())
+}
+fn account_id() -> Result<Option<String>> {
+    Ok(auth::AuthConfig::new(config::get_config())?
+        .cache
+        .credentials()
+        .and_then(|c| c.username)
+        .filter(|s| !s.is_empty())
+        .map(|s| hash(s.as_bytes())))
+}
+fn index_path(paths: &Paths, id: &str) -> PathBuf {
+    paths.account(id).join("index.json")
+}
+fn load_index(paths: &Paths, id: &str) -> Result<Index> {
+    let path = index_path(paths, id);
+    for candidate in [&path, &path.with_extension("json.bak")] {
+        if let Ok(index) = read_json::<Index>(candidate) {
+            ensure!(
+                index.version == VERSION && index.account_id == id,
+                "account_changed"
+            );
+            return Ok(index);
+        }
+    }
+    ensure!(!path.exists(), "snapshot_index_corrupt");
+    Ok(Index::empty(id))
+}
+fn save_index(paths: &Paths, index: &Index) -> Result<()> {
+    let path = index_path(paths, &index.account_id);
+    if path.exists() {
+        write_json(
+            &path.with_extension("json.bak"),
+            &load_index(paths, &index.account_id)?,
+        )?;
+    }
+    write_json(&path, index)
+}
+fn entry_library(paths: &Paths, id: &str, entry: &Entry) -> Result<Library> {
+    ensure!(
+        !entry.directory.is_empty()
+            && entry
+                .directory
+                .bytes()
+                .all(|c| c.is_ascii_hexdigit() || c == b'-'),
+        "invalid generation directory"
+    );
+    Ok(Library::new(
+        paths.account(id).join("generations").join(&entry.directory),
+    ))
+}
+fn select_complete(library: &Library, uri: &str, entry: &Entry) -> Result<Vec<Download>> {
+    ensure!(!entry.tracks.is_empty(), "empty_playlist");
+    let tracks = library.select(Some(uri))?;
+    ensure!(
+        tracks.len() == entry.tracks.len()
+            && tracks
+                .iter()
+                .zip(&entry.tracks)
+                .all(|(a, b)| a.uri == b.uri),
+        "incomplete_snapshot"
+    );
+    for track in &tracks {
+        library.verify_cover(track)?;
+    }
+    Ok(tracks)
+}
+fn publish_catalog(paths: &Paths, error: Option<&str>) -> Result<()> {
+    let id_result = account_id();
+    let mut catalog_error = error.map(str::to_owned);
+    let id = if let Ok(id) = id_result {
+        id
+    } else {
+        catalog_error = Some("authentication_required".into());
+        None
+    };
+    let mut playlists = BTreeMap::new();
+    if let Some(id) = &id {
+        let index = load_index(paths, id).unwrap_or_else(|_| {
+            catalog_error = Some("snapshot_index_corrupt".into());
+            Index::empty(id)
+        });
+        for (uri, entry) in index.playlists {
+            let ready = entry_library(paths, id, &entry)
+                .and_then(|l| select_complete(&l, &uri, &entry))
+                .is_ok();
+            playlists.insert(
+                uri,
+                PublicEntry {
+                    ready,
+                    name: entry.name,
+                    snapshot_id: entry.snapshot_id,
+                    synced_at: entry.synced_at,
+                    bytes: entry.bytes,
+                    tracks: entry.tracks,
+                },
+            );
+        }
+    }
+    write_json(
+        &paths.catalog,
+        &Catalog {
+            version: VERSION,
+            account_ready: id.is_some(),
+            account_id: id,
+            used_bytes: used_bytes(&paths.root).unwrap_or(0),
+            free_bytes: free_bytes(&paths.root).unwrap_or(0),
+            quota_bytes: paths.quota,
+            playlists,
+            error: catalog_error,
+        },
+    )
+}
+fn publish_job(paths: &Paths, job: &Job) -> Result<()> {
+    write_json(&paths.job, job)?;
+    // On a full card the RAM status still reports the error and the old index survives.
+    let _ = write_json(
+        &paths.root.join("last-job.json"),
+        &SavedJob {
+            process: Process::current()?,
+            status: job.clone(),
+        },
+    );
+    Ok(())
+}
+fn recover_job(paths: &Paths) -> Result<()> {
+    if let Ok(mut saved) = read_json::<SavedJob>(&paths.root.join("last-job.json")) {
+        if saved.status.account_id != account_id()? {
+            saved.status.uri.clear();
+            saved.status.tracks.clear();
+            saved.status.phase = "idle".into();
+            saved.status.completed = 0;
+            saved.status.total = 0;
+            saved.status.error = None;
+        }
+        if ["resolving", "downloading", "verifying"].contains(&saved.status.phase.as_str())
+            && !saved.process.alive()
+        {
+            saved.status.phase = "interrupted".into();
+            saved.status.error = Some("interrupted".into());
+        }
+        write_json(&paths.job, &saved.status)?;
+    }
+    Ok(())
+}
+fn reuse(old: &Library, target: &Path) -> Result<()> {
+    for file in fs::read_dir(old.root())? {
+        let file = file?;
+        let path = file.path();
+        if path.is_file()
+            && path
+                .extension()
+                .is_some_and(|ext| ext == "spdl" || ext == "img")
+        {
+            let destination = target.join(file.file_name());
+            if !destination.exists() {
+                fs::hard_link(path, destination)?;
+            }
+        }
+    }
+    Ok(())
+}
+fn check_capacity(paths: &Paths, bytes: u64) -> Result<()> {
+    ensure!(
+        used_bytes(&paths.root)?.saturating_add(bytes.saturating_mul(3)) <= paths.quota,
+        "storage_full: offline quota reached"
+    );
+    ensure!(
+        free_bytes(&paths.root)? >= bytes.saturating_mul(3).saturating_add(RESERVE),
+        "storage_full: insufficient free space"
+    );
+    Ok(())
+}
+fn prune_stage(library: &Library, uris: &[String]) -> Result<()> {
+    let mut keep = HashSet::new();
+    for uri in uris {
+        let track = library.track(uri)?;
+        keep.insert(uri.rsplit(':').next().context("track ID")?.to_owned() + ".spdl");
+        if let Some(url) = &track.cover_url {
+            keep.insert(
+                library
+                    .cover_path(url)
+                    .file_name()
+                    .context("cover name")?
+                    .to_string_lossy()
+                    .into_owned(),
+            );
+        }
+    }
+    for item in fs::read_dir(library.root())? {
+        let item = item?;
+        if item.file_type()?.is_file()
+            && !keep.contains(&item.file_name().to_string_lossy().into_owned())
+        {
+            fs::remove_file(item.path())?;
+        }
+    }
+    Ok(())
+}
+fn cleanup_generations(paths: &Paths, id: &str) -> Result<()> {
+    let mut keep = HashSet::new();
+    for path in [
+        index_path(paths, id),
+        index_path(paths, id).with_extension("json.bak"),
+    ] {
+        if let Ok(index) = read_json::<Index>(&path) {
+            for entry in index.playlists.values() {
+                keep.insert(entry.directory.clone());
+            }
+        }
+    }
+    if let Ok(record) = read_json::<SessionRecord>(&paths.root.join("playback.json")) {
+        if record.account_id == id && record.process.alive() {
+            keep.insert(record.directory);
+        }
+    }
+    let root = paths.account(id).join("generations");
+    if root.is_dir() {
+        for item in fs::read_dir(root)? {
+            let item = item?;
+            if item.file_type()?.is_dir()
+                && !keep.contains(&item.file_name().to_string_lossy().into_owned())
+            {
+                fs::remove_dir_all(item.path())?;
+            }
+        }
+    }
+    Ok(())
+}
+fn commit(
+    paths: &Paths,
+    id: &str,
+    uri: &str,
+    name: String,
+    snapshot: String,
+    library: &Library,
+    tracks: Vec<Track>,
+) -> Result<()> {
+    ensure!(account_id()?.as_deref() == Some(id), "account_changed");
+    commit_files(paths, id, uri, name, snapshot, library, tracks)
+}
+fn commit_files(
+    paths: &Paths,
+    id: &str,
+    uri: &str,
+    name: String,
+    snapshot: String,
+    library: &Library,
+    tracks: Vec<Track>,
+) -> Result<()> {
+    let directory = format!(
+        "{}-{:x}-{:x}",
+        hash(uri.as_bytes()),
+        now(),
+        rand::random::<u64>()
+    );
+    let generations = paths.account(id).join("generations");
+    fs::create_dir_all(&generations)?;
+    let entry = Entry {
+        directory: directory.clone(),
+        name,
+        snapshot_id: snapshot,
+        synced_at: now(),
+        bytes: tracks.iter().map(|t| t.bytes).sum(),
+        tracks,
+    };
+    select_complete(library, uri, &entry)?;
+    sync_dir(library.root())?;
+    fs::rename(library.root(), generations.join(&directory))?;
+    sync_dir(library.root().parent().context("pending parent")?)?;
+    sync_dir(&generations)?;
+    let mut index = load_index(paths, id)?;
+    index.playlists.insert(uri.into(), entry);
+    // Only this final atomic index update makes the new generation visible.
+    ensure!(
+        serde_json::to_vec(&index)?.len() as u64 <= MAX_JSON - 512,
+        "metadata_limit"
+    );
+    save_index(paths, &index)?;
+    sync_dir(&paths.root.join("accounts"))?;
+    sync_dir(&paths.root)
+}
+async fn synchronize(paths: &Paths, uri: &str) -> Result<()> {
+    let _lock = Lock::take(&paths.root.join("sync.lock"))?;
+    if let Ok(record) = read_json::<SessionRecord>(&paths.root.join("playback.json")) {
+        let paused = read_json::<serde_json::Value>(&record.status)
+            .is_ok_and(|status| status["phase"] == "paused");
+        ensure!(
+            !record.process.alive() || paused,
+            "busy: pause offline playback before synchronizing"
+        );
+    }
+    let id = account_id()?.context("authentication_required")?;
+    let stage = paths.pending(&id, uri);
+    let library = Library::new(stage.clone());
+    library.create()?;
+    let old = load_index(paths, &id)?;
+    if let Some(entry) = old.playlists.get(uri) {
+        reuse(&entry_library(paths, &id, entry)?, &stage)?;
+    }
+    for item in fs::read_dir(&stage)? {
+        let item = item?;
+        if item.file_name().to_string_lossy().starts_with(".tmp") && item.file_type()?.is_file() {
+            fs::remove_file(item.path())?;
+        }
+    }
+    let mut job = Job {
+        version: VERSION,
+        request: paths.request.clone(),
+        account_id: Some(id.clone()),
+        process: Process::current()?,
+        uri: uri.into(),
+        phase: "resolving".into(),
+        completed: 0,
+        total: 0,
+        bytes: 0,
+        tracks: Vec::new(),
+        error: None,
+    };
+    publish_job(paths, &job)?;
+    let result = async {
+        let client = AppClient::cached().await?;
+        let state::Context::Playlist { playlist, tracks } = client
+            .playlist_context_exact(PlaylistId::from_uri(uri)?)
+            .await?
+        else {
+            bail!("unsupported_playlist");
+        };
+        ensure!(!tracks.is_empty(), "empty_playlist");
+        let expected: Vec<String> = tracks.iter().map(|t| t.id.uri()).collect();
+        job.total = tracks.len();
+        job.tracks = tracks.iter().map(Track::from).collect();
+        job.phase = "downloading".into();
+        publish_job(paths, &job)?;
+        let auth = auth::AuthConfig {
+            cache: librespot_core::cache::Cache::new(
+                Some(config::get_config().cache_folder.clone()),
+                None,
+                None,
+                None,
+            )?,
+            login_redirect_uri: config::get_config().app_config.login_redirect_uri.clone(),
+        };
+        let session = auth.session();
+        let creds = auth::get_creds(&auth, false, true)?;
+        tokio::time::timeout(Duration::from_secs(30), session.connect(creds, true))
+            .await
+            .context("Spotify connection timeout")??;
+        let downloaded = async {
+            for (index, track) in tracks.iter().enumerate() {
+                ensure!(account_id()?.as_deref() == Some(&id), "account_changed");
+                let track_uri = &expected[index];
+                if !library.contains_valid(track_uri) {
+                    let estimate = (track.duration.as_millis() as u64).saturating_mul(12000) / 1000;
+                    check_capacity(paths, estimate.saturating_add(1024 * 1024))?;
+                    super::download_checked(&session, &library, track_uri, |bytes| {
+                        check_capacity(paths, bytes)
+                    })
+                    .await?;
+                }
+                let saved = library.track(track_uri)?;
+                if !saved
+                    .cover_url
+                    .as_deref()
+                    .is_none_or(|url| library.cover_is_valid(url))
+                {
+                    super::download_cover(&library, saved.cover_url.as_deref()).await?;
+                }
+                library.verify_cover(&saved)?;
+                job.bytes += saved.bytes;
+                job.tracks[index] = Track::from(saved);
+                job.completed = index + 1;
+                publish_job(paths, &job)?;
+                tokio::time::sleep(Duration::from_millis(500)).await;
+            }
+            Result::<()>::Ok(())
+        }
+        .await;
+        session.shutdown();
+        downloaded?;
+        job.phase = "verifying".into();
+        publish_job(paths, &job)?;
+        for track in &job.tracks {
+            ensure!(library.contains_valid(&track.uri), "incomplete_snapshot");
+        }
+        let state::Context::Playlist {
+            playlist: after,
+            tracks: after_tracks,
+        } = client
+            .playlist_context_exact(PlaylistId::from_uri(uri)?)
+            .await?
+        else {
+            bail!("unsupported_playlist");
+        };
+        ensure!(
+            playlist.snapshot_id == after.snapshot_id
+                && expected == after_tracks.iter().map(|t| t.id.uri()).collect::<Vec<_>>(),
+            "playlist_changed"
+        );
+        prune_stage(&library, &expected)?;
+        library.save_collection(uri, &expected)?;
+        commit(
+            paths,
+            &id,
+            uri,
+            playlist.name,
+            playlist.snapshot_id,
+            &library,
+            job.tracks.clone(),
+        )?;
+        publish_catalog(paths, None)?;
+        job.phase = "complete".into();
+        publish_job(paths, &job)
+    }
+    .await;
+    if let Err(error) = &result {
+        job.phase = "error".into();
+        job.error = Some(error_code(error).into());
+        if serde_json::to_vec(&job).map_or(true, |bytes| bytes.len() as u64 > MAX_JSON) {
+            job.tracks.clear();
+        }
+        let _ = publish_job(paths, &job);
+        let _ = publish_catalog(paths, None);
+        let _ = fs::write(paths.root.join("last-error.log"), format!("{error:#}\n"));
+    }
+    if result.is_ok() {
+        let _ = cleanup_generations(paths, &id);
+    }
+    result
+}
+fn error_code(error: &anyhow::Error) -> &'static str {
+    let text = format!("{error:#}");
+    if error
+        .chain()
+        .filter_map(|e| e.downcast_ref::<std::io::Error>())
+        .any(|e| e.raw_os_error() == Some(rustix::io::Errno::NOSPC.raw_os_error()))
+        || text.contains("storage_full")
+    {
+        "storage_full"
+    } else if text.contains("account_changed") {
+        "account_changed"
+    } else if text.contains("authentication_required")
+        || text.contains("cached credentials")
+        || text.contains("BadCredentials")
+    {
+        "authentication_required"
+    } else if text.contains("playlist_changed") {
+        "playlist_changed"
+    } else if text.contains("unsupported_playlist") || text.contains("metadata_limit") {
+        "unsupported_playlist"
+    } else if text.contains("busy:") {
+        "busy"
+    } else {
+        "download_failed"
+    }
+}
+fn send_stop(record: &SessionRecord) -> Result<()> {
+    let data = read_json::<serde_json::Value>(&record.control).unwrap_or_default();
+    let id = data["commands"]
+        .as_array()
+        .into_iter()
+        .flatten()
+        .filter_map(|c| c["id"].as_u64())
+        .max()
+        .unwrap_or(0)
+        .saturating_add(1);
+    write_json(
+        &record.control,
+        &serde_json::json!({"session":record.session,"commands":[{"id":id,"action":"stop"}]}),
+    )
+}
+fn take_playback(paths: &Paths) -> Result<Lock> {
+    if let Ok(lock) = Lock::take(&paths.root.join("playback.lock")) {
+        return Ok(lock);
+    }
+    if let Ok(record) = read_json::<SessionRecord>(&paths.root.join("playback.json")) {
+        if record.process.alive() {
+            send_stop(&record)?;
+        }
+    }
+    let start = Instant::now();
+    while start.elapsed() < Duration::from_secs(4) {
+        if let Ok(lock) = Lock::take(&paths.root.join("playback.lock")) {
+            return Ok(lock);
+        }
+        std::thread::sleep(Duration::from_millis(100));
+    }
+    bail!("busy: previous offline playback has not stopped")
+}
+fn same_account(id: &str) -> bool {
+    account_id().is_ok_and(|current| current.as_deref() == Some(id))
+}
+fn resume_path(paths: &Paths, id: &str, uri: &str) -> PathBuf {
+    paths
+        .account(id)
+        .join("resume")
+        .join(hash(uri.as_bytes()) + ".json")
+}
+fn save_resume(
+    paths: &Paths,
+    record: &SessionRecord,
+    tracks: &[Download],
+    status: &player::Status,
+) {
+    if let Some(track) = status.current.and_then(|i| tracks.get(i)) {
+        let _ = write_json(
+            &resume_path(paths, &record.account_id, &record.uri),
+            &Resume {
+                account_id: record.account_id.clone(),
+                uri: record.uri.clone(),
+                track_uri: track.uri.clone(),
+                position_ms: status.position_ms,
+            },
+        );
+    }
+}
+fn run_playback(paths: &Paths, args: &ArgMatches, uri: &str) -> Result<()> {
+    let session = args
+        .get_one::<String>("session")
+        .context("missing session")?;
+    ensure!(
+        !session.is_empty()
+            && session.len() <= 64
+            && session.bytes().all(|c| c.is_ascii_digit() || c == b'-'),
+        "invalid session identifier"
+    );
+    let id = account_id()?.context("authentication_required")?;
+    let _lock = take_playback(paths)?;
+    let index = load_index(paths, &id)?;
+    let entry = index.playlists.get(uri).context("no_complete_snapshot")?;
+    let library = entry_library(paths, &id, entry)?;
+    let tracks = select_complete(&library, uri, entry)?;
+    let mut initial = *args
+        .get_one::<usize>("index")
+        .context("missing track index")?;
+    let mut seek_ms = 0;
+    if args.get_flag("resume") {
+        if let Ok(saved) = read_json::<Resume>(&resume_path(paths, &id, uri)) {
+            if saved.account_id == id && saved.uri == uri {
+                if let Some(i) = tracks.iter().position(|t| t.uri == saved.track_uri) {
+                    initial = i;
+                    seek_ms = saved
+                        .position_ms
+                        .min(tracks[i].duration_ms.saturating_sub(1));
+                }
+            }
+        }
+    }
+    ensure!(initial < tracks.len(), "invalid track index");
+    let record = SessionRecord {
+        process: Process::current()?,
+        session: session.clone(),
+        uri: uri.into(),
+        account_id: id,
+        directory: entry.directory.clone(),
+        control: args
+            .get_one::<String>("control")
+            .context("missing control path")?
+            .into(),
+        status: args
+            .get_one::<String>("status")
+            .context("missing status path")?
+            .into(),
+    };
+    write_json(&paths.root.join("playback.json"), &record)?;
+    let status = Arc::new(Mutex::new(player::Status {
+        current: None,
+        position_ms: 0,
+        playing: false,
+        ended: false,
+        volume: 100,
+        error: None,
+    }));
+    let (sender, receiver) = flume::unbounded();
+    let worker_status = status.clone();
+    let worker_library = library.clone();
+    let worker_tracks = tracks.clone();
+    let worker = std::thread::Builder::new()
+        .name("offline-audio".into())
+        .spawn(move || {
+            if let Err(error) =
+                player::audio_loop(&worker_library, &worker_tracks, &receiver, &worker_status)
+            {
+                let mut state = worker_status.lock();
+                state.error = Some(format!("{error:#}"));
+                state.playing = false;
+            }
+        })?;
+    let _ = sender.send(player::Control::Play(initial));
+    if seek_ms > 0 {
+        let _ = sender.send(player::Control::Seek(i64::from(seek_ms)));
+    }
+    let mut ack = 0;
+    let mut started = false;
+    let mut stopped = false;
+    let mut last_resume = Instant::now();
+    let mut last_publish = Instant::now()
+        .checked_sub(Duration::from_secs(1))
+        .unwrap_or_else(Instant::now);
+    let result: Result<()> = (|| {
+        loop {
+            if !same_account(&record.account_id) {
+                bail!("account_changed");
+            }
+            if let Ok(controls) = read_json::<Controls>(&record.control) {
+                if controls.session == record.session && controls.commands.len() <= 64 {
+                    for command in controls.commands {
+                        if command.id <= ack {
+                            continue;
+                        }
+                        let control = match command.action.as_str() {
+                            "stop" => {
+                                stopped = true;
+                                Some(player::Control::Stop)
+                            }
+                            "pause" => Some(player::Control::PlayState(false)),
+                            "resume" => Some(player::Control::PlayState(true)),
+                            "next" => Some(player::Control::NextBounded),
+                            "prev" => Some(player::Control::PreviousOrRestart),
+                            "seek" => command.value.map(|ms| {
+                                player::Control::SeekTo(ms.clamp(0, i64::from(u32::MAX)) as u32)
+                            }),
+                            "skip" => command.value.map(|seconds| {
+                                player::Control::Seek(seconds.clamp(-86400, 86400) * 1000)
+                            }),
+                            _ => None,
+                        };
+                        if let Some(control) = control {
+                            let _ = sender.send(control);
+                        }
+                        ack = command.id;
+                    }
+                }
+            }
+            let state = status.lock().clone();
+            started |= state.current.is_some();
+            if last_publish.elapsed() >= Duration::from_millis(500) {
+                write_json(
+                    &record.status,
+                    &Playback {
+                        version: VERSION,
+                        process: record.process.clone(),
+                        session: record.session.clone(),
+                        phase: if state.error.is_some() {
+                            "error"
+                        } else if state.ended {
+                            "ended"
+                        } else if state.playing {
+                            "playing"
+                        } else if started {
+                            "paused"
+                        } else {
+                            "starting"
+                        }
+                        .into(),
+                        index: state.current.unwrap_or(initial),
+                        position_ms: state.position_ms,
+                        ack,
+                        error: state.error.as_ref().map(|_| "audio_error".into()),
+                    },
+                )?;
+                last_publish = Instant::now();
+            }
+            if last_resume.elapsed() >= Duration::from_secs(15) {
+                save_resume(paths, &record, &tracks, &state);
+                last_resume = Instant::now();
+            }
+            if stopped || state.error.is_some() {
+                break;
+            }
+            // At the end the worker drops the decoder and keeps the final position.
+            if state.ended {
+                break;
+            }
+            std::thread::sleep(Duration::from_millis(100));
+        }
+        Ok(())
+    })();
+    let _ = sender.send(player::Control::Stop);
+    let joined = worker.join();
+    let final_state = status.lock().clone();
+    save_resume(paths, &record, &tracks, &final_state);
+    write_json(
+        &record.status,
+        &Playback {
+            version: VERSION,
+            process: record.process.clone(),
+            session: record.session.clone(),
+            phase: if result.is_err() || final_state.error.is_some() {
+                "error"
+            } else if stopped {
+                "stopped"
+            } else {
+                "ended"
+            }
+            .into(),
+            index: final_state.current.unwrap_or(initial),
+            position_ms: final_state.position_ms,
+            ack,
+            error: if result.is_err() {
+                Some("account_changed".into())
+            } else {
+                final_state.error.as_ref().map(|_| "audio_error".into())
+            },
+        },
+    )?;
+    result?;
+    ensure!(joined.is_ok(), "audio_worker_failed");
+    ensure!(final_state.error.is_none(), "audio_error");
+    Ok(())
+}
+fn remove(paths: &Paths, uri: &str) -> Result<()> {
+    let _lock = Lock::take(&paths.root.join("sync.lock"))?;
+    if let Ok(record) = read_json::<SessionRecord>(&paths.root.join("playback.json")) {
+        ensure!(
+            !record.process.alive() || record.uri != uri,
+            "busy: snapshot is playing"
+        );
+    }
+    let id = account_id()?.context("authentication_required")?;
+    let mut index = load_index(paths, &id)?;
+    if let Some(entry) = index.playlists.remove(uri) {
+        let dir = entry_library(paths, &id, &entry)?.root().to_path_buf();
+        save_index(paths, &index)?;
+        fs::remove_dir_all(dir)?;
+    }
+    let pending = paths.pending(&id, uri);
+    if pending.exists() {
+        fs::remove_dir_all(pending)?;
+    }
+    let _ = write_json(&index_path(paths, &id).with_extension("json.bak"), &index);
+    let prefix = hash(uri.as_bytes()) + "-";
+    let generations = paths.account(&id).join("generations");
+    if generations.is_dir() {
+        for item in fs::read_dir(generations)? {
+            let item = item?;
+            if item.file_type()?.is_dir() && item.file_name().to_string_lossy().starts_with(&prefix)
+            {
+                fs::remove_dir_all(item.path())?;
+            }
+        }
+    }
+    publish_catalog(paths, None)
+}
+fn forget(paths: &Paths) -> Result<()> {
+    if let Ok(record) = read_json::<SessionRecord>(&paths.root.join("playback.json")) {
+        if record.process.alive() {
+            send_stop(&record)?;
+        }
+    }
+    if let Ok(process) = read_json::<Process>(&paths.root.join("sync.lock")) {
+        if process.alive() {
+            if let Some(pid) = rustix::process::Pid::from_raw(process.pid as i32) {
+                let _ = rustix::process::kill_process(pid, rustix::process::Signal::TERM);
+            }
+        }
+        let start = Instant::now();
+        while process.alive() && start.elapsed() < Duration::from_secs(3) {
+            std::thread::sleep(Duration::from_millis(100));
+        }
+        ensure!(!process.alive(), "busy: sync has not stopped");
+    }
+    let _lock = take_playback(paths)?;
+    let cache = &config::get_config().cache_folder;
+    for name in [
+        "credentials.json".to_owned(),
+        format!("{}_token.json", auth::NCSPOT_CLIENT_ID),
+    ] {
+        let path = cache.join(name);
+        if path.exists() {
+            fs::remove_file(path)?;
+        }
+    }
+    publish_catalog(paths, None)
+}
+
+pub fn handle(args: &ArgMatches) -> Result<()> {
+    rustix::process::umask(rustix::fs::Mode::from_raw_mode(0o077));
+    let paths = Paths {
+        request: args
+            .get_one::<String>("request")
+            .cloned()
+            .unwrap_or_default(),
+        root: args
+            .get_one::<String>("store")
+            .context("missing store")?
+            .into(),
+        catalog: args
+            .get_one::<String>("catalog")
+            .context("missing catalog")?
+            .into(),
+        job: args.get_one::<String>("job").context("missing job")?.into(),
+        quota: *args
+            .get_one::<u64>("quota-bytes")
+            .context("missing quota")?,
+    };
+    fs::create_dir_all(&paths.root)?;
+    let tmp = paths.root.join("tmp");
+    fs::create_dir_all(&tmp)?;
+    std::env::set_var("TMPDIR", &tmp);
+    let (command, sub) = args.subcommand().context("managed command required")?;
+    let uri = sub
+        .try_get_one::<String>("uri")
+        .ok()
+        .flatten()
+        .map(|s| super::parse_source(s))
+        .transpose()?;
+    if let Some(uri) = &uri {
+        ensure!(
+            uri.starts_with("spotify:playlist:"),
+            "managed playlists only"
+        );
+    }
+    let result = match command {
+        "catalog" => {
+            recover_job(&paths)?;
+            publish_catalog(&paths, None)
+        }
+        "sync" => tokio::runtime::Runtime::new()?.block_on(synchronize(
+            &paths,
+            uri.as_deref().context("missing playlist")?,
+        )),
+        "play" => run_playback(&paths, sub, uri.as_deref().context("missing playlist")?),
+        "remove" => remove(&paths, uri.as_deref().context("missing playlist")?),
+        "forget" => forget(&paths),
+        _ => bail!("unknown managed command"),
+    };
+    if let Err(error) = &result {
+        let code = error_code(error);
+        if command == "sync" && code != "busy" {
+            if let Some(uri) = &uri {
+                let _ = publish_job(
+                    &paths,
+                    &Job {
+                        version: VERSION,
+                        request: paths.request.clone(),
+                        account_id: account_id().ok().flatten(),
+                        process: Process::current()?,
+                        uri: uri.clone(),
+                        phase: "error".into(),
+                        completed: 0,
+                        total: 0,
+                        bytes: 0,
+                        tracks: Vec::new(),
+                        error: Some(code.into()),
+                    },
+                );
+            }
+        }
+        if command == "play" {
+            if let (Some(session), Some(path)) = (
+                sub.get_one::<String>("session"),
+                sub.get_one::<String>("status"),
+            ) {
+                let _ = write_json(
+                    Path::new(path),
+                    &Playback {
+                        version: VERSION,
+                        process: Process::current()?,
+                        session: session.clone(),
+                        phase: "error".into(),
+                        index: 0,
+                        position_ms: 0,
+                        ack: 0,
+                        error: Some(code.into()),
+                    },
+                );
+            }
+        }
+        let _ = publish_catalog(&paths, Some(code));
+    }
+    result
+}
