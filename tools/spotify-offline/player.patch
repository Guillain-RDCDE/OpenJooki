+    job: PathBuf,
+    quota: u64,
+    request: String,
+}
+impl Paths {
+    fn account(&self, id: &str) -> PathBuf {
+        self.root.join("accounts").join(id)
+    }
+    fn pending(&self, id: &str, uri: &str) -> PathBuf {
+        self.account(id).join("pending").join(hash(uri.as_bytes()))
+    }
+}
