+#[cfg(test)]
+mod tests {
+    use super::*;
+    use librespot_audio::AudioDecrypt;
+    use librespot_core::audio_key::AudioKey;
+    use std::io::Read;
+    const URI: &str = "spotify:playlist:1111111111111111111111";
+    const ACCOUNT: &str = "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa";
+    fn paths(root: &Path) -> Paths {
+        Paths {
+            request: "test".into(),
+            root: root.join("store"),
+            catalog: root.join("runtime/catalog.json"),
+            job: root.join("runtime/job.json"),
+            quota: 64 * 1024 * 1024,
+        }
