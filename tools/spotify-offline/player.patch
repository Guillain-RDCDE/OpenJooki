+        let a = fixture(&lib, "1111111111111111111111", "First");
+        let b = fixture(&lib, "2222222222222222222222", "Second");
+        publish(&p, vec![b.clone(), a.clone(), b.clone()]).unwrap();
+        let old = load_index(&p, ACCOUNT).unwrap();
+        let old_dir = old.playlists[URI].directory.clone();
+        let lib = stage(&p);
+        lib.create().unwrap();
+        fixture(&lib, "1111111111111111111111", "First");
+        assert!(publish(&p, vec![a, b]).is_err());
+        let index = load_index(&p, ACCOUNT).unwrap();
+        assert_eq!(index.playlists[URI].directory, old_dir);
+        let ready = entry_library(&p, ACCOUNT, &index.playlists[URI]).unwrap();
+        let tracks = select_complete(&ready, URI, &index.playlists[URI]).unwrap();
+        assert_eq!(
+            tracks.iter().map(|t| t.name.as_str()).collect::<Vec<_>>(),
+            vec!["Second", "First", "Second"]
+        );
+    }
+    #[test]
+    fn hard_link_reuse_does_not_corrupt_the_previous_copy_when_replacing_a_track() {
