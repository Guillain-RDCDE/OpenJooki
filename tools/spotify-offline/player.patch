@@ -0,0 +1,91 @@
+use anyhow::{ensure, Context, Result};
+use librespot_core::{Session, SpotifyUri};
+use librespot_metadata::{
+    audio::{AudioItem, UniqueFields},
+    playlist::Playlist,
+    Metadata as _,
+};
+use serde::{Deserialize, Serialize};
+use sha2::{Digest, Sha256};
+use std::fmt::Write as _;
+
+pub(super) const PAGE_SIZE: usize = 50;
+pub(super) struct Listing {
+    pub name: String,
+    pub revision: String,
+    pub uris: Vec<String>,
+}
+
+pub(super) async fn listing(session: &Session, uri: &str) -> Result<Listing> {
+    let playlist = Playlist::get(session, &SpotifyUri::from_uri(uri)?).await?;
+    ensure!(
+        playlist.length >= 0 && playlist.length <= 10_000,
+        "playlist_too_large"
+    );
+    let uris = playlist
+        .tracks()
+        .map(SpotifyUri::to_uri)
+        .collect::<std::result::Result<Vec<_>, _>>()?;
+    ensure!(
+        !playlist.contents.is_truncated
+            && playlist.contents.position == 0
+            && uris.len() == playlist.length as usize,
+        "playlist_incomplete: metadata page was truncated"
+    );
+    let revision = Sha256::digest(&playlist.revision).iter().fold(
+        String::with_capacity(64),
+        |mut out, byte| {
+            let _ = write!(out, "{byte:02x}");
+            out
+        },
+    );
+    Ok(Listing {
+        name: playlist.name().to_owned(),
+        revision,
+        uris,
+    })
+}
+
+#[derive(Clone, Serialize, Deserialize)]
+pub(super) struct Song {
+    pub uri: String,
+    pub name: String,
+    pub artists: Vec<String>,
+    pub album: String,
+    pub duration_ms: u32,
+    pub bytes: u64,
+    pub problem: Option<String>,
+}
+
+pub(super) async fn song(session: &Session, uri: &str) -> Result<Song> {
+    let item = AudioItem::get_file(session, SpotifyUri::from_uri(uri)?)
+        .await
+        .context("playlist item metadata unavailable")?;
+    let problem = if !uri.starts_with("spotify:track:") {
+        Some("unsupported_item".into())
+    } else if item.alternatives.is_none() && (item.availability.is_err() || item.files.is_empty()) {
+        Some("track_unavailable".into())
+    } else {
+        None
+    };
+    let (artists, album) = match &item.unique_fields {
+        UniqueFields::Track { artists, album, .. } => (
+            artists.0.iter().map(|a| a.name.clone()).collect(),
+            album.clone(),
+        ),
+        UniqueFields::Episode { show_name, .. } => (vec![show_name.clone()], show_name.clone()),
+        UniqueFields::Local { artists, album, .. } => (
+            artists.clone().into_iter().collect(),
+            album.clone().unwrap_or_default(),
+        ),
+    };
+    Ok(Song {
+        uri: uri.to_owned(),
+        name: item.name,
+        artists,
+        album,
+        duration_ms: item.duration_ms,
+        bytes: 0,
+        problem,
+    })
+}
