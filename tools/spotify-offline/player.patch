+        let p = paths(root.path());
+        let lib = stage(&p);
+        let a = fixture(&lib, "1111111111111111111111", "Original");
+        publish(&p, vec![a]).unwrap();
+        let old = load_index(&p, ACCOUNT).unwrap();
+        let old_lib = entry_library(&p, ACCOUNT, &old.playlists[URI]).unwrap();
+        let lib = stage(&p);
+        lib.create().unwrap();
+        reuse(&old_lib, lib.root()).unwrap();
+        fixture(&lib, "1111111111111111111111", "Replacement");
+        assert_eq!(
+            old_lib
+                .track("spotify:track:1111111111111111111111")
