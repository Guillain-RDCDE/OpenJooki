+    #[test]
+    fn large_playlists_keep_every_position_while_public_pages_stay_bounded() {
+        let root = tempfile::tempdir().unwrap();
+        let p = paths(root.path());
+        let lib = stage(&p);
+        let a = fixture(&lib, "1111111111111111111111", &"Long title ".repeat(20));
+        let b = fixture(&lib, "2222222222222222222222", "Second");
+        let tracks: Vec<_> = (0..710)
+            .map(|i| if i % 2 == 0 { a.clone() } else { b.clone() })
+            .collect();
+        publish(&p, tracks.clone()).unwrap();
+        let index = load_index(&p, ACCOUNT).unwrap();
+        let entry = &index.playlists[URI];
+        let saved = entry_library(&p, ACCOUNT, entry).unwrap();
+        let actual = select_complete(&saved, URI, entry).unwrap();
+        assert_eq!(actual.len(), 710);
+        assert!(actual.iter().zip(tracks).all(|(a, b)| a.uri == b.uri));
+        assert!(fs::metadata(index_path(&p, ACCOUNT)).unwrap().len() > PUBLIC_JSON);
+        let public = PublicEntry {
+            ready: true,
+            total_tracks: entry.tracks.len(),
+            name: entry.name.clone(),
+            snapshot_id: entry.snapshot_id.clone(),
+            synced_at: entry.synced_at,
+            bytes: entry.bytes,
