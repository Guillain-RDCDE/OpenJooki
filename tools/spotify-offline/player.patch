+
+const VERSION: u32 = 1;
+const MAX_JSON: u64 = 128 * 1024;
+const RESERVE: u64 = 16 * 1024 * 1024;
+
+pub fn command() -> Command {
+    Command::new("managed")
+        .about("Experimental OpenJooki snapshots and playback file protocol")
+        .arg(Arg::new("store").long("store").required(true))
+        .arg(Arg::new("catalog").long("catalog").required(true))
+        .arg(Arg::new("job").long("job").required(true))
+        .arg(
+            Arg::new("quota-bytes")
+                .long("quota-bytes")
+                .default_value("536870912")
+                .value_parser(clap::value_parser!(u64).range(1_048_576..)),
+        )
+        .arg(Arg::new("request").long("request").default_value("manual"))
+        .subcommand_required(true)
+        .subcommand(Command::new("catalog"))
+        .subcommand(Command::new("sync").arg(Arg::new("uri").required(true)))
+        .subcommand(Command::new("remove").arg(Arg::new("uri").required(true)))
+        .subcommand(Command::new("forget"))
+        .subcommand(
+            Command::new("play")
+                .arg(Arg::new("uri").required(true))
+                .arg(Arg::new("session").long("session").required(true))
+                .arg(Arg::new("control").long("control").required(true))
+                .arg(Arg::new("status").long("status").required(true))
+                .arg(
+                    Arg::new("index")
+                        .long("index")
+                        .default_value("0")
+                        .value_parser(clap::value_parser!(usize)),
+                )
+                .arg(Arg::new("resume").long("resume").action(ArgAction::SetTrue)),
+        )
+}
