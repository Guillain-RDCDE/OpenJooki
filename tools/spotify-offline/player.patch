+    fn hard_link_reuse_does_not_corrupt_the_previous_copy_when_replacing_a_track() {
+        let root = tempfile::tempdir().unwrap();
+        let p = paths(root.path());
+        let lib = stage(&p);
+        let a = fixture(&lib, "1111111111111111111111", "Original");
+        publish(&p, vec![a]).unwrap();
+        let old = load_index(&p, ACCOUNT).unwrap();
+        let old_lib = entry_library(&p, ACCOUNT, &old.playlists[URI]).unwrap();
+        let lib = stage(&p);
+        lib.create().unwrap();
+        reuse(&old_lib, lib.root()).unwrap();
+        fixture(&lib, "1111111111111111111111", "Replacement");
+        assert_eq!(
+            old_lib
+                .track("spotify:track:1111111111111111111111")
+                .unwrap()
+                .name,
+            "Original"
+        );
+    }
+    #[test]
+    fn account_namespaces_never_select_another_accounts_snapshot() {
+        let root = tempfile::tempdir().unwrap();
+        let p = paths(root.path());
+        let lib = stage(&p);
+        let a = fixture(&lib, "1111111111111111111111", "Private");
+        publish(&p, vec![a]).unwrap();
